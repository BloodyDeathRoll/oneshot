# node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# oneshot
# (no trailing slash: in a checkout this is a link into ~/.oneshot/assets, made by tools/link-assets.sh)
dossier/*/assets
dist/
.env
.env.*
!.env.example

# os / editor
.DS_Store

# A 4e mockup is one hand-written HTML file (designer 0.3.0): its dist/index.html and dist/img/
# are the source, not a build product, so they are tracked despite the dist/ rule above.
# The 4g build output (sites/*/final/dist/) stays ignored by that rule.
!sites/*/mockups/*/dist/

# ...except the Astro-built dist/ of the mockups made before designer 0.3.0, which are build products
sites/the-lavish-haven/mockups/*/dist/
# Layday's round-2 mockups (interactive was picked 2026-09-20), moved aside for the 2026-09-22 re-run of 4d-4f
sites/layday-surf-ahangama/mockups-picked-02/*/dist/
sites/layday-surf-ahangama/mockups-picked-02/*/node_modules
sites/layday-surf-ahangama/mockups-picked-02/*/public/photos/
sites/layday-surf-ahangama/mockups-picked-02/*/.astro/
# KA's round-2 mockups, rejected; kept for reference, same artefacts ignored as when they were mockups/
sites/ka-surf-hostel-and-restaurant/mockups-rejected-02/*/dist/
sites/ka-surf-hostel-and-restaurant/mockups-rejected-02/*/node_modules
sites/ka-surf-hostel-and-restaurant/mockups-rejected-02/*/public/photos/
sites/ka-surf-hostel-and-restaurant/mockups-rejected-02/*/.astro/

# Astro build artefacts of mockups made before designer 0.3.0 (regenerate with tools/build-mockup.mjs)
sites/*/mockups/*/node_modules
sites/*/mockups/*/public/photos/
sites/*/mockups/*/.astro/

# local archives of sites/ (too large for git hosting)
sites/*.zip

# CMS (cms/): Next build output, server-side backups (client content)
.next/
*.tsbuildinfo
next-env.d.ts
cms/backups/

# wrangler local state
.wrangler/

# dashboard: generated by tools/dashboard.mjs from the ledger; the template is the source
dashboard/index.html
dashboard/data.json

# dashboard mockups: dist/index.html is the built artefact Shahar picks from; keep it, like the site mockups
!dashboard/mockups/*/dist/

# funnel.mjs --shots per-page captures: large, reproducible, not evidence unless an audit cites them
dossier/*/funnel/page-*.png

# shoot.mjs per-viewport frames: the contact sheets (*-sheet.png) and shoot.json are the record; frames are reproducible
sites/*/mockups/*/shots/**/desktop-[0-9]*.png
sites/*/mockups/*/shots/**/mobile-[0-9]*.png

# mockup video renditions: copies of dossier/<slug>/assets/video/ (git-ignored), reproducible with tools/fetch-video.mjs
# (no trailing slash: a link into ~/.oneshot/assets, made by tools/link-assets.sh)
sites/*/mockups/*/dist/video
sites/*/mockups-rejected-*/*/dist/video

# Images and video never go in git (decided 2026-10-02, docs/team.md). They live on each operator's
# disk and in the local store (~/.oneshot/assets); media/<slug>.tsv lists every file and how to get
# it back (tools/media.mjs). SVG is markup, not a picture, and stays tracked.
*.[pP][nN][gG]
*.[jJ][pP][gG]
*.[jJ][pP][eE][gG]
*.webp
*.gif
*.avif
*.heic
*.tif
*.tiff
*.bmp
*.ico
*.mp4
*.webm
*.mov
*.m4v
*.mkv
*.avi
# review screenshots are scratch, deleted after scoring (tools/clean-shots.mjs)
shots/
!agents/designer/gold/shots/
# session handoff is local, per machine
handoff.md
