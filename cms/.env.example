# Copy with ./scripts/init-env.sh (generates every secret below). .env is git-ignored, mode 600,
# and lives only on the CMS server. Never commit real values.

CMS_ADDRESS=130-61-212-182.sslip.io        # Caddy site address; a real hostname later
SERVER_URL=https://130-61-212-182.sslip.io # public URL of the CMS
COOKIE_SECURE=true
POSTGRES_PASSWORD=                         # generated
PAYLOAD_SECRET=                            # generated; also encrypts API keys — changing it invalidates them
SUPERADMIN_EMAIL=admin@oneshot.test
SUPERADMIN_PASSWORD=                       # generated; first boot creates this super-admin
BUILDER_API_KEY=                           # generated; read-only key the site builds use
PUBLISH_SECRET=                            # generated; shared secret between the CMS hook and the publisher
DEPLOY_MODE=dry-run                        # dry-run | live   (live really runs `wrangler deploy`)
DEBOUNCE_MS=1500
TEMPLATES_DIR=../sites                     # one dir per tenant slug, synced by deploy/managed/sync-template.sh
CLOUDFLARE_API_TOKEN=                      # Shahar pastes the scoped token here, on the server only
CLOUDFLARE_ACCOUNT_ID=
BACKUP_PAR_URL=                            # OCI pre-authenticated request, write-only (AnyObjectWrite), bucket oneshot-cms-backups
