---
/* book/: the URL the home page's drawer pushes (concepts.md C3 "the side desk"), and the booking path with
   JavaScript off: the same form as a page of its own, under a solid header. */
import css from '../../styles/site.css?raw'
import js from '../../scripts/site.js?raw'
import { fontFaces, fontPreloads, TIER } from '../../lib/head.mjs'
import { c, CT, SPRITE, header, footer, bookForm, pageData } from '../../lib/site.mjs'

const pre = '../'
const data = { ...pageData(pre), plates: null, rosa: null, page: 'book' }
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{`${CT.hero_c3} | ${c.businessName}`}</title>
<meta name="description" content={c.tagline}>
<Fragment set:html={fontPreloads(pre)} />
<script is:inline set:html={TIER}></script>
<style is:inline set:html={fontFaces(pre) + css}></style>
</head>
<body>
<a class="skip" href="#bookform">Skip to the booking form</a>
<Fragment set:html={SPRITE} />
<Fragment set:html={header(pre, false)} />
<main id="top">
<Fragment set:html={bookForm(pre, true)} />
</main>
<Fragment set:html={footer(pre)} />
<script is:inline type="application/json" id="pagedata" set:html={JSON.stringify(data).replace(/</g, '\\u003c')}></script>
<script is:inline set:html={js}></script>
</body>
</html>
