      "testimonials": [
        {
          "date": null,
          "id": "seed-quote-1",
          "quote": "We loved the cozy, bohoo-vibes at the lodge: starting from the open-air-bathroom, the relaxing pool area and especially the great breakfast bowls!",
          "author": "Fanny, Germany",
          "source": "booking"
        },
        {
          "date": null,
          "id": "seed-quote-2",
          "quote": "This place felt like something inbetween a hostel and a luxurious hotel. The styling was gorgeous, the beds very comfortable, the (bath)room very spacious with lockers and personal storage space.",
          "author": "Myrthe, Netherlands",
          "source": "booking"
        },
        {
          "date": null,
          "id": "seed-quote-3",
          "quote": "A lovely hotel and a team of champions. Ariel, a professional surf guide, raised the level of surfing for us by several steps during the week we were there. This is our second time at the same hotel and with the same guide. We will return next year as well",
          "author": "Seagallas",
          "source": "other"
        },
        {
