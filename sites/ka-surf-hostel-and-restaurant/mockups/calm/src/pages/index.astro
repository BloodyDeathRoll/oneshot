---
import { c, block, blocks, paras, photo, rating } from '../lib/content';
import '../styles/site.css';
import BookingMark from '../components/BookingMark.astro';
import AgodaMark from '../components/AgodaMark.astro';
import HostelworldMark from '../components/HostelworldMark.astro';
import PhoneMark from '../components/PhoneMark.astro';

const hero = photo('img-002');
const hw = rating('hostelworld'), bk = rating('booking'), gg = rating('google');
const intro = block('intro');
const [family, breakfast] = blocks('about');
const rooms = block('offer');
const [whatsHere, gettingHere] = blocks('info');
const gallery = ['img-013', 'img-003', 'img-014', 'img-012', 'img-004', 'img-001', 'img-005', 'img-008'];
const bands = { rooms: photo('img-011'), amen: photo('img-009'), quotes: photo('img-016'), wave: photo('img-019') };
const marks = { hostelworld: HostelworldMark, booking: BookingMark, agoda: AgodaMark };
const platform = (label) => label.toLowerCase().includes('hostelworld') ? 'hostelworld'
  : label.toLowerCase().includes('agoda') ? 'agoda' : 'booking';
const mapUrl = 'https://www.google.com/maps/search/KA%20Surf%20Hostel%20Ahangama/@5.9736,80.3639,17z?hl=en';
const si = c.stayInfo;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{c.businessName} — {c.tagline}</title>
<meta name="description" content={`${c.tagline}. ${paras(intro.body)[0]}`} />
<link rel="preload" href="fonts/newsreader.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>

<a class="sr" href="#book">Skip to booking</a>

<header class="site-head wrap">
  <div>
    <div class="name">{c.businessName}</div>
    <div class="where">Ahangama · Sri Lanka</div>
  </div>
  <a class="btn head-book" href="#book">Check dates</a>
</header>

<section class="hero">
  <figure>
    <img src={hero.src} srcset={hero.srcset} sizes="100vw" width={hero.width} height={hero.height}
         alt={hero.alt} fetchpriority="high" />
    <div class="scrim"></div>
  </figure>
  <div class="words">
    <div class="wrap">
      <h1>{c.tagline}</h1>
      <p class="tagline">A family hostel five minutes from Kabalana Beach, with breakfast at one long table.</p>
      <p class="scores">
        {hw && <span><b>{hw.score}</b>/{hw.scale} Hostelworld · {hw.count} reviews</span>}
        {bk && <span><b>{bk.score}</b>/{bk.scale} Booking.com · {bk.count}</span>}
        {gg && <span><b>{gg.score}</b>/{gg.scale} Google · {gg.count}</span>}
      </p>
    </div>
  </div>
</section>

<!-- Three platforms, because this hostel sells on all three and its strongest
     score is on Hostelworld. The links are copied from the dossier. -->
<section class="dock" id="book">
  <div class="wrap inner">
    <div class="acts">
      {c.bookingLinks.map((b, i) => {
        const Mark = marks[platform(b.label)];
        return <a class={i === 0 ? 'btn btn--solid' : 'btn'} href={b.url} rel="noopener">
          <Mark light={i === 0} /> {b.label}
        </a>;
      })}
      <a class="btn" href={`tel:${c.contact.phone}`}><PhoneMark /> Call the hostel</a>
    </div>
    <p class="note">Beds and rooms are sold through these three listings — they hold the live prices and availability. Reception answers the phone around the clock.</p>
  </div>
</section>

<main>

<section class="sec wrap">
  <p class="eyebrow">Where it is</p>
  <div class="two-col">
    <h2>{intro.heading}</h2>
    <div>{paras(intro.body).map((p, i) => <p class={i === 0 ? 'lead' : ''}>{p}</p>)}</div>
  </div>
  <div class="gallery run-in">
    {gallery.map((id) => {
      const p = photo(id);
      return <img src={p.src} srcset={p.srcset} sizes="(min-width: 720px) 24vw, 46vw"
                  width={p.width} height={p.height} alt={p.alt} loading="lazy" decoding="async" />;
    })}
  </div>
</section>

<div class="band" role="img" aria-label={bands.rooms.alt} style={`background-image:url(${bands.rooms.src})`}></div>

<section class="sec wrap">
  <p class="eyebrow">The family</p>
  <div class="two-col">
    <h2>{family.heading}</h2>
    <div>{paras(family.body).map((p, i) => <p class={i === 0 ? 'lead' : ''}>{p}</p>)}</div>
  </div>
  <div class="two-col run-in">
    <h2>{breakfast.heading}</h2>
    <div>{paras(breakfast.body).map((p) => <p>{p}</p>)}</div>
  </div>
</section>

<section class="sec wrap">
  <p class="eyebrow">Beds and rooms</p>
  <div class="two-col">
    <h2>{rooms.heading}</h2>
    <div>{paras(rooms.body).map((p) => <p>{p}</p>)}</div>
  </div>
  <ul class="rooms run-in">
    {c.rooms.map((r) => (
      <li><span class="label">{r.label}</span><span class="beds">{r.beds}{r.note ? `, ${r.note}` : ''}</span></li>
    ))}
  </ul>
</section>

<div class="band" role="img" aria-label={bands.amen.alt} style={`background-image:url(${bands.amen.src})`}></div>

<section class="sec wrap">
  <p class="eyebrow">What is here</p>
  <div class="two-col">
    <h2>{whatsHere.heading}</h2>
    <div>{paras(whatsHere.body).map((p) => <p>{p}</p>)}</div>
  </div>
  <ul class="amen run-in">
    {c.amenities.map((a) => <li>{a.label}{a.note ? <span class="note"> — {a.note}</span> : null}</li>)}
  </ul>
</section>

<div class="band" role="img" aria-label={bands.quotes.alt} style={`background-image:url(${bands.quotes.src})`}></div>

<section class="sec wrap">
  <p class="eyebrow">What guests wrote</p>
  <h2 style="max-width:20ch">Everyone uses the same word</h2>
  <div class="quotes run-in">
    {c.testimonials.map((t) => (
      <figure class="quote">
        <blockquote>“{t.quote}”</blockquote>
        <figcaption>{t.author} — on {t.source === 'booking' ? 'Booking.com' : t.source === 'hostelworld' ? 'Hostelworld' : t.source}</figcaption>
      </figure>
    ))}
  </div>
</section>

<div class="band" role="img" aria-label={bands.wave.alt} style={`background-image:url(${bands.wave.src})`}></div>

<section class="sec wrap">
  <p class="eyebrow">The wave</p>
  <div class="wave">
    <p class="lead">{c.spot}</p>
    <div class="widget">
      <iframe
        src="https://rosa.surf/widget/?spot=kabalana&theme=light&units=metric"
        title="Rosa surf forecast - Kabalana"
        width="100%" height="500"
        style="max-width:420px;border:0;border-radius:16px;display:block"
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
        sandbox="allow-scripts allow-popups allow-popups-to-escape-sandbox allow-same-origin"
      ></iframe>
      <p>Live forecast for Kabalana from rosa.surf.</p>
    </div>
  </div>
</section>

<section class="sec wrap">
  <p class="eyebrow">Getting here</p>
  <div class="here">
    <h2>{gettingHere.heading}</h2>
    <div>
      {paras(gettingHere.body).map((p) => <p>{p}</p>)}
      <ul class="facts run-in" style="margin-top:28px">
        <li><span class="k">Check in</span><span>{si.checkInFrom}–{si.checkInTo}</span></li>
        <li><span class="k">Check out</span><span>by {si.checkOutTo}</span></li>
        <li><span class="k">Address</span><span>{c.contact.address}</span></li>
        <li><span class="k">Good to know</span><span>{si.note}</span></li>
      </ul>
    </div>
  </div>
</section>

</main>

<footer class="foot">
  <div class="wrap">
    <div class="cols">
      <div>
        <h3>Where</h3>
        <p>{c.contact.address}</p>
        <p><a class="link" href={mapUrl} rel="noopener">Open in Google Maps</a></p>
      </div>
      <div>
        <h3>Reception</h3>
        <p><a class="link" href={`tel:${c.contact.phone}`}>{c.contact.phone}</a></p>
        <p>Open 24 hours.</p>
      </div>
      <div>
        <h3>Book</h3>
        <ul>{c.bookingLinks.map((b) => <li><a class="link" href={b.url} rel="noopener">{b.label}</a></li>)}</ul>
      </div>
    </div>
    <p class="legal">Mockup 1 of 3 — “calm”. Every fact on this page comes from the dossier harvested on 19 September 2026; see notes.md. Photographs are the hostel's own.</p>
  </div>
</footer>

<nav class="mobile-dock" aria-label="Book">
  <a href={c.bookingLinks[0].url} rel="noopener">Check dates</a>
  <a class="alt" href={`tel:${c.contact.phone}`}>Call</a>
</nav>

</body>
</html>
