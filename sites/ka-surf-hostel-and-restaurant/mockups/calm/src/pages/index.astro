---
import { c, block, blocks, paras, photo, rating } from '../lib/content';
import '../styles/site.css';
import BookingMark from '../components/BookingMark.astro';
import AgodaMark from '../components/AgodaMark.astro';
import HostelworldMark from '../components/HostelworldMark.astro';
import PhoneMark from '../components/PhoneMark.astro';

const hw = rating('hostelworld'), bk = rating('booking'), gg = rating('google');
const intro = block('intro');
const [family, breakfast] = blocks('about');
const rooms = block('offer');
const [whatsHere, gettingHere] = blocks('info');
const marks = { hostelworld: HostelworldMark, booking: BookingMark, agoda: AgodaMark };
const platform = (l) => l.toLowerCase().includes('hostelworld') ? 'hostelworld' : l.toLowerCase().includes('agoda') ? 'agoda' : 'booking';
const site = (p) => p === 'hostelworld' ? 'Hostelworld' : p === 'booking' ? 'Booking.com' : 'Google';
const mapUrl = 'https://www.google.com/maps/search/KA%20Surf%20Hostel%20Ahangama/@5.9736,80.3639,17z?hl=en';
const si = c.stayInfo;
/* The six things the copy names, in the copy's own words. Nothing added. */
const menu = ['Rotis', 'Hoppers', 'Pancakes', 'Eggs', 'A fruit platter', 'A vegan option if you need one'];
const prints = [
  { id: 'img-002' }, { id: 'img-013' }, { id: 'img-003', portrait: true }, { id: 'img-014' },
  { id: 'img-012' }, { id: 'img-004', portrait: true }, { id: 'img-005', portrait: true }, { id: 'img-011' },
  { id: 'img-017' }, { id: 'img-001', portrait: true }, { id: 'img-016' }, { id: 'img-020' },
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{c.businessName} — {c.tagline}</title>
<meta name="description" content={`${c.tagline}. ${paras(intro.body)[0]}`} />
<link rel="preload" href="fonts/newsreader.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>

<a class="sr" href="#book">Skip to booking</a>

<!-- The board head. No photograph: KA's best picture is 576 px wide and has no
     business filling a screen. Type, three scores, three places to book. -->
<header class="head wrap" id="book">
  <h1 class="name">{c.businessName}</h1>
  <p class="where">Ahangama · Sri Lanka · five minutes from Kabalana</p>
  <p class="claim">{c.tagline}. Breakfast is included, it is Sri Lankan, and it changes every morning.</p>

  <ul class="tags">
    {[hw, bk, gg].filter(Boolean).map((r) => (
      <li class="tag"><b>{r.score}</b>/{r.scale} {site(r.platform)} · {r.count}</li>
    ))}
  </ul>

  <div class="book-row">
    {c.bookingLinks.map((b, i) => {
      const Mark = marks[platform(b.label)];
      return <a class={i === 0 ? 'book-card book-card--first' : 'book-card'} href={b.url} rel="noopener">
        <Mark light={i === 0} /> {site(platform(b.label))}
      </a>;
    })}
    <a class="book-card" href={`tel:${c.contact.phone}`}><PhoneMark /> Call</a>
  </div>
  <p class="book-note">Beds and rooms are sold through these three listings — they hold the live prices and availability. Reception answers the phone around the clock.</p>
</header>

<main class="wrap">

<section class="sec pin-grid pin-grid--2">
  <div class="card menu">
    <p class="kicker">Pinned up every morning</p>
    <h2>{breakfast.heading}</h2>
    <ul>
      {menu.map((m, i) => <li>{m}<span>{String(i + 1).padStart(2, '0')}</span></li>)}
    </ul>
    <p class="foot">Included in the bed. It changes daily, which guests mention more often than anything else on the property.</p>
  </div>
  <div class="card card--tint">
    <p class="kicker">Where it is</p>
    <h2>{intro.heading}</h2>
    {paras(intro.body).map((p) => <p>{p}</p>)}
  </div>
</section>

<section class="sec pin-grid pin-grid--2">
  <div class="card">
    <p class="kicker">Who runs it</p>
    <h2>{family.heading}</h2>
    {paras(family.body).map((p) => <p>{p}</p>)}
  </div>
  <div class="prints prints--narrow">
    {prints.slice(0, 4).map(({ id, portrait }) => {
      const p = photo(id);
      return (
        <figure class={portrait ? 'print print--portrait' : 'print'}>
          <img src={p.src} srcset={p.srcset} sizes="(min-width: 720px) 210px, 45vw"
               width={p.width} height={p.height} alt={p.alt} loading="lazy" decoding="async" />
        </figure>
      );
    })}
  </div>
</section>

<section class="sec">
  <p class="kicker" style="color:var(--chalk-dim)">Pinned to the wall</p>
  <div class="prints">
    {prints.slice(4).map(({ id, portrait }) => {
      const p = photo(id);
      return (
        <figure class={portrait ? 'print print--portrait' : 'print'}>
          <img src={p.src} srcset={p.srcset} sizes="(min-width: 720px) 210px, 45vw"
               width={p.width} height={p.height} alt={p.alt} loading="lazy" decoding="async" />
        </figure>
      );
    })}
  </div>
</section>

<section class="sec">
  <div class="card">
    <p class="kicker">Beds and rooms · {c.rooms.length} kinds</p>
    <h2>{rooms.heading}</h2>
    {paras(rooms.body).map((p) => <p>{p}</p>)}
    <ul class="ledger" style="margin-top:26px">
      {c.rooms.map((r, i) => (
        <li>
          <span class="what">{r.label}</span>
          <span class="detail">{r.beds}</span>
          <a class="go" href={c.bookingLinks[0].url} rel="noopener"><span>Check</span></a>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="sec">
  <p class="kicker" style="color:var(--chalk-dim)">What is here</p>
  <p style="max-width:36rem;margin-bottom:20px">{paras(whatsHere.body)[0]}</p>
  <ul class="labels">
    {c.amenities.map((a) => <li>{a.label}{a.note ? <em> — {a.note}</em> : null}</li>)}
  </ul>
</section>

<section class="sec">
  <p class="kicker" style="color:var(--chalk-dim)">What guests wrote · everyone uses the same word</p>
  <div class="quotes">
    {c.testimonials.map((t) => (
      <figure class="qcard">
        <blockquote>“{t.quote}”</blockquote>
        <figcaption>{t.author} — {t.source === 'booking' ? 'Booking.com' : t.source === 'hostelworld' ? 'Hostelworld' : t.source}</figcaption>
      </figure>
    ))}
  </div>
</section>

<section class="sec wave">
  <div class="card card--tint">
    <p class="kicker">The wave</p>
    <h2 style="max-width:14ch">Kabalana, five minutes on foot</h2>
    <p>{c.spot}</p>
    <p class="kicker" style="margin-top:28px">Getting here</p>
    {paras(gettingHere.body).map((p) => <p>{p}</p>)}
    <ul class="facts">
      <li><span class="k">Check in</span><span>{si.checkInFrom}–{si.checkInTo}</span></li>
      <li><span class="k">Check out</span><span>by {si.checkOutTo}</span></li>
      <li><span class="k">Address</span><span>{c.contact.address}</span></li>
      <li><span class="k">Good to know</span><span>{si.note}</span></li>
    </ul>
  </div>
  <div class="widget">
    <iframe
      src="https://rosa.surf/widget/?spot=kabalana&theme=light&units=metric"
      title="Rosa surf forecast - Kabalana"
      width="100%" height="500"
      style="max-width:420px;border:0;border-radius:12px;display:block"
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
      sandbox="allow-scripts allow-popups allow-popups-to-escape-sandbox allow-same-origin"
    ></iframe>
    <p>Kabalana today — rosa.surf</p>
  </div>
</section>

<footer class="foot">
  <div class="cols">
    <div>
      <h3>Where</h3>
      <p>{c.contact.address}</p>
      <p><a class="link" href={mapUrl} rel="noopener">Open in Google Maps</a></p>
    </div>
    <div>
      <h3>Reception</h3>
      <p><a class="link" href={`tel:${c.contact.phone}`}>{c.contact.phone}</a></p>
      <p>Open 24 hours.</p>
    </div>
    <div>
      <h3>Book</h3>
      <ul>{c.bookingLinks.map((b) => <li><a class="link" href={b.url} rel="noopener">{b.label}</a></li>)}</ul>
    </div>
  </div>
  <p class="legal">Mockup 1 of 3 — “calm”, on the noticeboard archetype (see <code>concepts.md</code>). Every fact on this page comes from the dossier harvested on 19 September 2026; see notes.md. Photographs are the hostel's own and are shown at postcard size, because the largest is 1024 px and the best is 576 px wide.</p>
</footer>

</main>

<nav class="mobile-dock" aria-label="Book">
  <a href={c.bookingLinks[0].url} rel="noopener">Check dates</a>
  <a class="alt" href={`tel:${c.contact.phone}`}>Call</a>
</nav>

</body>
</html>
