---
import { c, block, blocks, paras, photo, rating } from '../lib/content';
import '../styles/site.css';
import BookingMark from '../components/BookingMark.astro';
import AgodaMark from '../components/AgodaMark.astro';
import HostelworldMark from '../components/HostelworldMark.astro';
import PhoneMark from '../components/PhoneMark.astro';

const hw = rating('hostelworld'), bk = rating('booking'), gg = rating('google');
const intro = block('intro');
const [family, breakfast] = blocks('about');
const rooms = block('offer');
const [whatsHere, gettingHere] = blocks('info');
const marks = { hostelworld: HostelworldMark, booking: BookingMark, agoda: AgodaMark };
const platform = (l) => l.toLowerCase().includes('hostelworld') ? 'hostelworld' : l.toLowerCase().includes('agoda') ? 'agoda' : 'booking';
const site = (p) => p === 'hostelworld' ? 'Hostelworld' : p === 'booking' ? 'Booking.com' : 'Google';
const mapUrl = 'https://www.google.com/maps/search/KA%20Surf%20Hostel%20Ahangama/@5.9736,80.3639,17z?hl=en';
const si = c.stayInfo;
/* the six items the copy names, in the copy's own words */
const menu = ['Rotis', 'Hoppers', 'Pancakes', 'Eggs', 'A fruit platter', 'A vegan option if you need one'];
/* distances, all from copy/en.json "Getting here" */
const legs = [
  ['Kabalana Beach', 'a five-minute walk'],
  ['Ahangama railway station', 'a little over 2 km'],
  ['Koggala Airport', 'about 5 km'],
];
const chart = photo('stock-008'), rose = photo('stock-009');
const beach = photo('stock-001'), shore = photo('stock-006'), dusk = photo('stock-003'), palm = photo('stock-005');
const inside = ['img-002', 'img-014', 'img-011', 'img-012'];
const inside2 = ['img-004', 'img-001', 'img-005', 'img-013'];
/* every borrowed photograph on this page, with the credit it must carry */
const borrowed = [chart, rose, beach, shore, dusk, palm];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{c.businessName} — {c.tagline}</title>
<meta name="description" content={`${c.tagline}. ${paras(intro.body)[0]}`} />
<link rel="preload" href="fonts/spacegrotesk.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>

<a class="sr" href="#book">Skip to booking</a>

<header class="site-head">
  <span class="name">KA Surf Hostel</span>
  <span class="coord">5°58′N · 80°22′E · Ahangama</span>
</header>

<!-- The chart beside the water, the name across the seam. The organising fact
     of this business is where it is, so the page opens on position. -->
<section class="split">
  <figure class="chart">
    <img src={chart.src} srcset={chart.srcset} sizes="(min-width: 900px) 50vw, 100vw"
         width={chart.width} height={chart.height} alt={chart.alt} fetchpriority="high" />
    <figcaption class="credit">{chart.credit}</figcaption>
  </figure>
  <figure>
    <img src={beach.src} srcset={beach.srcset} sizes="(min-width: 900px) 50vw, 100vw"
         width={beach.width} height={beach.height} alt={beach.alt} fetchpriority="high" />
    <figcaption class="credit credit--onphoto">{beach.credit}</figcaption>
  </figure>
  <div class="say">
    <div class="wrap">
      <h1>{c.tagline}</h1>
      <p class="claim">A family hostel on the south coast, five minutes on foot from Kabalana. Breakfast is included, it is Sri Lankan, and it changes every morning.</p>
      <p class="measure">
        <span class="n">5 min</span>
        <span class="bar"></span>
        <span class="to">on foot to Kabalana Beach</span>
      </p>
    </div>
  </div>
</section>

<section class="scores">
  {[hw, bk, gg].filter(Boolean).map((r) => (
    <div>
      <p class="n">{r.score}<span> /{r.scale}</span></p>
      <p>{site(r.platform)} · {r.count} reviews</p>
    </div>
  ))}
</section>

<section class="book" id="book">
  <div class="row">
    {c.bookingLinks.map((b, i) => {
      const Mark = marks[platform(b.label)];
      return <a class={i === 0 ? 'book-card book-card--first' : 'book-card'} href={b.url} rel="noopener"><Mark light={i === 0} /> {site(platform(b.label))}</a>;
    })}
    <a class="book-card" href={`tel:${c.contact.phone}`}><PhoneMark /> Call</a>
  </div>
  <p class="note">Beds and rooms are sold through these three listings — they hold the live prices and availability. Reception answers the phone around the clock.</p>
</section>

<main>

<section class="sec">
  <div class="wrap cols2">
    <div>
      <p class="eyebrow">Where it is</p>
      <h2>{intro.heading}</h2>
    </div>
    <div>{paras(intro.body).map((p, i) => <p class={i === 0 ? 'lead' : ''}>{p}</p>)}</div>
  </div>
  <div class="wrap">
    <div class="inside">
      {inside.map((id) => {
        const p = photo(id);
        return <img src={p.src} srcset={p.srcset} sizes="(min-width: 760px) 23vw, 46vw"
                    width={p.width} height={p.height} alt={p.alt} loading="lazy" decoding="async" />;
      })}
    </div>
  </div>
</section>

<figure class="bleed" style="margin:0">
  <img src={shore.src} srcset={shore.srcset} sizes="100vw" width={shore.width} height={shore.height}
       alt={shore.alt} loading="lazy" decoding="async" />
  <figcaption class="credit">{shore.credit}</figcaption>
</figure>

<section class="sec">
  <div class="wrap cols2">
    <div>
      <p class="eyebrow">Who runs it</p>
      <h2>{family.heading}</h2>
    </div>
    <div>{paras(family.body).map((p, i) => <p class={i === 0 ? 'lead' : ''}>{p}</p>)}</div>
  </div>
</section>

<section class="sec">
  <div class="wrap cols2">
    <div>
      <p class="eyebrow">Every morning</p>
      <h2>{breakfast.heading}</h2>
      <ul class="menu">{menu.map((m, i) => <li data-n={String(i + 1).padStart(2, '0')}>{m}</li>)}</ul>
    </div>
    <div>{paras(breakfast.body).map((p) => <p>{p}</p>)}</div>
  </div>
</section>

<section class="sec">
  <div class="wrap cols2">
    <div>
      <p class="eyebrow">Beds and rooms · {c.rooms.length} kinds</p>
      <h2>{rooms.heading}</h2>
    </div>
    <div>{paras(rooms.body).map((p) => <p>{p}</p>)}</div>
  </div>
  <div class="wrap">
    <ul class="beds">
      {c.rooms.map((r) => (
        <li>
          <span class="what">{r.label}</span>
          <span class="detail">{r.beds}</span>
          <a class="go" href={c.bookingLinks[0].url} rel="noopener"><span>Check</span></a>
        </li>
      ))}
    </ul>
    <div class="inside">
      {inside2.map((id) => {
        const p = photo(id);
        return <img src={p.src} srcset={p.srcset} sizes="(min-width: 760px) 23vw, 46vw"
                    width={p.width} height={p.height} alt={p.alt} loading="lazy" decoding="async" />;
      })}
    </div>
  </div>
</section>

<section class="sec">
  <div class="wrap">
    <p class="eyebrow">What is here</p>
    <p class="lead">{paras(whatsHere.body)[0]}</p>
    <ul class="amen">{c.amenities.map((a) => <li>{a.label}{a.note ? <span class="note"> — {a.note}</span> : null}</li>)}</ul>
  </div>
</section>

<figure class="bleed" style="margin:0">
  <img src={dusk.src} srcset={dusk.srcset} sizes="100vw" width={dusk.width} height={dusk.height}
       alt={dusk.alt} loading="lazy" decoding="async" />
  <figcaption class="credit">{dusk.credit}</figcaption>
</figure>

<section class="sec">
  <div class="wrap">
    <p class="eyebrow">What guests wrote · everyone uses the same word</p>
    <h2 style="max-width:16ch">Family, in sixty-six reviews</h2>
    <div class="quotes">
      {c.testimonials.map((t) => (
        <figure class="quote">
          <blockquote>“{t.quote}”</blockquote>
          <figcaption>{t.author} — {t.source === 'booking' ? 'Booking.com' : t.source === 'hostelworld' ? 'Hostelworld' : t.source}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<section class="sec">
  <div class="wrap wave">
    <div>
      <p class="eyebrow">The wave</p>
      <h2 style="max-width:14ch">Kabalana, five minutes on foot</h2>
      <p class="lead">{c.spot}</p>
    </div>
    <div class="widget">
      <iframe src="https://rosa.surf/widget/?spot=kabalana&theme=light&units=metric"
        title="Rosa surf forecast - Kabalana" width="100%" height="500"
        style="max-width:420px;border:0;border-radius:12px;display:block"
        loading="lazy" referrerpolicy="strict-origin-when-cross-origin"
        sandbox="allow-scripts allow-popups allow-popups-to-escape-sandbox allow-same-origin"></iframe>
      <p>Kabalana today — rosa.surf</p>
    </div>
  </div>
</section>

<section class="sec">
  <div class="wrap cols2">
    <div>
      <p class="eyebrow">Getting here</p>
      <h2>{gettingHere.heading}</h2>
      <ul class="legs">
        {legs.map(([place, dist]) => <li><span class="place">{place}</span><span class="dist">{dist}</span></li>)}
      </ul>
    </div>
    <div>
      {paras(gettingHere.body).map((p) => <p>{p}</p>)}
      <p style="margin-top:18px;color:var(--muted);font-size:15px">Check in {si.checkInFrom}–{si.checkInTo}, out by {si.checkOutTo}. {si.note}</p>
      <p style="margin-top:14px"><a class="link" href={mapUrl} rel="noopener">Open in Google Maps</a></p>
    </div>
  </div>
</section>

<figure class="bleed" style="margin:0">
  <img src={palm.src} srcset={palm.srcset} sizes="100vw" width={palm.width} height={palm.height}
       alt={palm.alt} loading="lazy" decoding="async" />
  <figcaption class="credit">{palm.credit}</figcaption>
</figure>

</main>

<footer class="foot">
  <div class="wrap">
    <div class="cols">
      <div>
        <h3>Where</h3>
        <p>{c.contact.address}</p>
        <p><a class="link" href={mapUrl} rel="noopener">Open in Google Maps</a></p>
      </div>
      <div>
        <h3>Reception</h3>
        <p><a class="link" href={`tel:${c.contact.phone}`}>{c.contact.phone}</a></p>
        <p>Open 24 hours.</p>
      </div>
      <div>
        <h3>Book</h3>
        <ul>{c.bookingLinks.map((b) => <li><a class="link" href={b.url} rel="noopener">{b.label}</a></li>)}</ul>
      </div>
    </div>
    <p class="legal">Mockup 1 of 3 — “calm”, on the chart archetype (see <code>concepts.md</code>). Every fact on this page comes from the dossier harvested on 19 September 2026; see notes.md. Photographs of the hostel, its rooms, its garden and its people are the hostel's own. The wide photographs of the coast and the chart are freely licensed and are of the place, not of this business.</p>
    <ul class="credits">
      {borrowed.map((p) => <li>{p.credit}</li>)}
    </ul>
  </div>
</footer>

<nav class="mobile-dock" aria-label="Book">
  <a href={c.bookingLinks[0].url} rel="noopener">Check dates</a>
  <a class="alt" href={`tel:${c.contact.phone}`}>Call</a>
</nav>

</body>
</html>
