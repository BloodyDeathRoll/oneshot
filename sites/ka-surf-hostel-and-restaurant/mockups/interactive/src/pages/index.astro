---
import { c, block, blocks, paras, photo, rating } from '../lib/content';
import '../styles/site.css';
import BookingMark from '../components/BookingMark.astro';
import AgodaMark from '../components/AgodaMark.astro';
import HostelworldMark from '../components/HostelworldMark.astro';
import PhoneMark from '../components/PhoneMark.astro';

const morning = photo('img-013'), midday = photo('img-019'), sunset = photo('img-016'), night = photo('img-002');
const hw = rating('hostelworld'), bk = rating('booking'), gg = rating('google');
const intro = block('intro');
const [family, breakfast] = blocks('about');
const rooms = block('offer');
const [whatsHere, gettingHere] = blocks('info');
const shapes = ['', 'plate--tall', 'plate--wide'];
const plates = ['img-003', 'img-014', 'img-012', 'img-004', 'img-005', 'img-001', 'img-017', 'img-008', 'img-020'];
const bands = { beds: photo('img-011'), quotes: photo('img-009') };
const marks = { hostelworld: HostelworldMark, booking: BookingMark, agoda: AgodaMark };
const platform = (label) => label.toLowerCase().includes('hostelworld') ? 'hostelworld'
  : label.toLowerCase().includes('agoda') ? 'agoda' : 'booking';
const mapUrl = 'https://www.google.com/maps/search/KA%20Surf%20Hostel%20Ahangama/@5.9736,80.3639,17z?hl=en';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{c.businessName} — {c.tagline}</title>
<meta name="description" content={`${c.tagline}. ${paras(intro.body)[0]}`} />
<link rel="preload" href="fonts/newsreader.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>

<a class="sr" href="#book">Skip to booking</a>

<header class="site-head">
  <span class="name">{c.businessName}</span>
  <a class="book-open" href="#book" data-open-drawer>Check dates</a>
</header>

<!-- A day at KA. Four of the hostel's own photographs, cross-faded on scroll,
     with the air shimmering over them. The canvas is an enhancement over the
     last of them. -->
<section class="day">
  <div class="stick">
    <img class="still" src={night.src} srcset={night.srcset} sizes="100vw"
         width={night.width} height={night.height} alt={night.alt} fetchpriority="high" />
    <canvas data-day data-sources={JSON.stringify([morning.src, midday.src, sunset.src, night.src])} aria-hidden="true"></canvas>
    <div class="veil"></div>
    <p class="clock" data-clock>Breakfast</p>
    <div class="words">
      <div class="wrap">
        <h1>{c.tagline}</h1>
        <p class="sub">A family runs this place, and you feel it about ten minutes after you drop your bag.</p>
        <p class="scores">
          {hw && <span><b>{hw.score}</b>/{hw.scale} Hostelworld · {hw.count}</span>}
          {bk && <span><b>{bk.score}</b>/{bk.scale} Booking.com · {bk.count}</span>}
          {gg && <span><b>{gg.score}</b>/{gg.scale} Google · {gg.count}</span>}
        </p>
      </div>
    </div>
  </div>
</section>

<main>

<section class="sec">
  <div class="wrap split">
    <div><p class="eyebrow">Where it is</p><h2 class="rise">{intro.heading}</h2></div>
    <div class="rise">{paras(intro.body).map((p, i) => <p class={i === 0 ? 'lead' : ''}>{p}</p>)}</div>
  </div>
</section>

<section class="sec">
  <div class="wrap split">
    <div><p class="eyebrow">The family</p><h2 class="rise">{family.heading}</h2></div>
    <div class="rise">{paras(family.body).map((p, i) => <p class={i === 0 ? 'lead' : ''}>{p}</p>)}</div>
  </div>
  <div class="wrap split" style="margin-top:48px">
    <div><p class="eyebrow">Every morning</p><h2 class="rise">{breakfast.heading}</h2></div>
    <div class="rise">{paras(breakfast.body).map((p) => <p>{p}</p>)}</div>
  </div>
</section>

<section class="sec">
  <div class="wrap">
    <p class="eyebrow">The place</p>
    <div class="plates">
      {plates.map((id, i) => {
        const p = photo(id);
        return (
          <figure class={`plate ${shapes[i % shapes.length]}`}>
            <div class="frame">
              <img src={p.src} srcset={p.srcset} sizes="(min-width: 1000px) 32vw, (min-width: 620px) 48vw, 92vw"
                   width={p.width} height={p.height} alt={p.alt} loading="lazy" decoding="async" />
            </div>
            <figcaption>{p.alt}</figcaption>
          </figure>
        );
      })}
    </div>
  </div>
</section>

<figure class="band">
  <img src={bands.beds.src} srcset={bands.beds.srcset} sizes="100vw" width={bands.beds.width}
       height={bands.beds.height} alt={bands.beds.alt} loading="lazy" decoding="async" />
  <figcaption>The garden</figcaption>
</figure>

<section class="sec">
  <div class="wrap">
    <p class="eyebrow">Beds and rooms · {c.rooms.length} kinds</p>
    <div class="split">
      <h2 class="rise">{rooms.heading}</h2>
      <div class="rise">{paras(rooms.body).map((p) => <p>{p}</p>)}</div>
    </div>
  </div>
  <div class="wrap">
    <div class="rail" role="group" aria-label="Beds and rooms — scroll sideways">
      {c.rooms.map((r, i) => (
        <article class="card">
          <span class="n">{String(i + 1).padStart(2, '0')}</span>
          <span class="label">{r.label}</span>
          <span class="beds">{r.beds}{r.note ? `, ${r.note}` : ''}</span>
          <a class="book" href="#book" data-open-drawer>Check this bed</a>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="sec">
  <div class="wrap split">
    <div><p class="eyebrow">What is here</p><h2 class="rise">{whatsHere.heading}</h2></div>
    <div class="rise">{paras(whatsHere.body).map((p) => <p>{p}</p>)}</div>
  </div>
  <div class="wrap">
    <ul class="amen">{c.amenities.map((a) => <li>{a.label}{a.note ? <span class="note"> — {a.note}</span> : null}</li>)}</ul>
  </div>
</section>

<figure class="band">
  <img src={bands.quotes.src} srcset={bands.quotes.srcset} sizes="100vw" width={bands.quotes.width}
       height={bands.quotes.height} alt={bands.quotes.alt} loading="lazy" decoding="async" />
  <figcaption>The garden after dark</figcaption>
</figure>

<section class="sec">
  <div class="wrap">
    <p class="eyebrow">What guests wrote</p>
    <h2 class="rise" style="max-width:20ch;margin-bottom:38px">Everyone uses the same word</h2>
    <div class="quotes">
      {c.testimonials.map((t) => (
        <figure class="quote rise">
          <blockquote>“{t.quote}”</blockquote>
          <figcaption>{t.author} — on {t.source === 'booking' ? 'Booking.com' : t.source === 'hostelworld' ? 'Hostelworld' : t.source}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<section class="sec">
  <div class="wrap wave">
    <div>
      <p class="eyebrow">The wave</p>
      <p class="lead rise">{c.spot}</p>
      <p class="eyebrow" style="margin-top:40px">Getting here</p>
      {paras(gettingHere.body).map((p) => <p class="rise">{p}</p>)}
    </div>
    <div class="widget">
      <iframe
        src="https://rosa.surf/widget/?spot=kabalana&theme=light&units=metric"
        title="Rosa surf forecast - Kabalana"
        width="100%" height="500"
        style="max-width:420px;border:0;border-radius:16px;display:block"
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
        sandbox="allow-scripts allow-popups allow-popups-to-escape-sandbox allow-same-origin"
      ></iframe>
      <p>Live forecast for Kabalana — rosa.surf</p>
    </div>
  </div>
</section>

</main>

<footer class="foot" id="book">
  <div class="wrap">
    <div class="cols">
      <div>
        <h3>Where</h3>
        <p>{c.contact.address}</p>
        <p><a href={mapUrl} rel="noopener">Open in Google Maps</a></p>
      </div>
      <div>
        <h3>Reception</h3>
        <p><a href={`tel:${c.contact.phone}`}>{c.contact.phone}</a></p>
        <p>Open 24 hours. Check in {c.stayInfo.checkInFrom}–{c.stayInfo.checkInTo}, out by {c.stayInfo.checkOutTo}.</p>
      </div>
      <div>
        <h3>Book</h3>
        <ul>{c.bookingLinks.map((b) => <li><a href={b.url} rel="noopener">{b.label}</a></li>)}</ul>
      </div>
    </div>
    <p class="legal">Mockup 2 of 3 — “interactive”. Every fact on this page comes from the dossier harvested on 19 September 2026; see notes.md. Photographs are the hostel's own; the shimmer over them is drawn in WebGL and alters nothing in the photographs.</p>
  </div>
</footer>

<details class="drawer" data-drawer>
  <summary>Booking</summary>
  <div class="backdrop" data-close-drawer></div>
  <div class="panel">
    <div class="inner">
      <button class="close" type="button" data-close-drawer>Close</button>
      <h2>Check dates</h2>
      <p>KA sells its beds and rooms on three listings, and they hold the live prices. Its best score — {hw?.score}/10 across {hw?.count} reviews — is on Hostelworld. Reception answers the phone around the clock.</p>
      <div class="acts">
        {c.bookingLinks.map((b, i) => {
          const Mark = marks[platform(b.label)];
          return <a class={i === 0 ? 'act act--clay' : 'act'} href={b.url} rel="noopener"><Mark light={i === 0} /> {b.label}</a>;
        })}
        <a class="act" href={`tel:${c.contact.phone}`}><PhoneMark /> Call {c.contact.phone}</a>
      </div>
    </div>
  </div>
</details>

<nav class="mobile-dock" aria-label="Book">
  <a href="#book" data-open-drawer>Check dates</a>
  <a class="alt" href={`tel:${c.contact.phone}`}>Call</a>
</nav>

<script>
import { startDay } from '../scripts/day.js';

const canvas = document.querySelector('[data-day]');
const clock = document.querySelector('[data-clock]');
const day = canvas && startDay(canvas, JSON.parse(canvas.dataset.sources));
if (day) {
  canvas.classList.add('on');
  const section = document.querySelector('.day');
  const labels = ['Breakfast', 'Midday', 'Sundown', 'Dinner'];
  const onScroll = () => {
    const travel = section.offsetHeight - innerHeight;
    const p = travel > 0 ? Math.min(1, Math.max(0, -section.getBoundingClientRect().top / travel)) : 0;
    day.setProgress(p);
    if (clock) clock.textContent = labels[Math.min(labels.length - 1, Math.round(p * (labels.length - 1)))];
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
}

const head = document.querySelector('.site-head');
const daySec = document.querySelector('.day');
const solid = () => head.classList.toggle('solid', daySec.getBoundingClientRect().bottom <= 78);
addEventListener('scroll', solid, { passive: true });
solid();

const io = new IntersectionObserver((es) => {
  for (const e of es) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
}, { rootMargin: '0px 0px -8%' });
document.querySelectorAll('.rise').forEach((el) => io.observe(el));

/* Kube's parallax recipe (references.md #17), off at <= 767px and reduced motion */
const wide = matchMedia('(min-width: 768px)');
const calm = matchMedia('(prefers-reduced-motion: reduce)');
const movers = [...document.querySelectorAll('.plate, .band')];
let ticking = false;
const par = () => {
  ticking = false;
  if (!wide.matches || calm.matches) return;
  const vh = innerHeight;
  for (const f of movers) {
    const r = f.getBoundingClientRect();
    if (r.bottom < -100 || r.top > vh + 100) continue;
    const k = Math.min(1, Math.max(0, (vh * 0.7 - r.top) / (vh * 0.7 + r.height * 0.3)));
    const amt = f.classList.contains('band') ? 5 : 4;
    f.querySelector('img').style.transform = `translate3d(0, ${(-k * amt).toFixed(2)}rem, 0)`;
  }
};
addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(par); } }, { passive: true });
addEventListener('resize', par);
par();

/* The triggers are real links to the footer booking block, so they work with
   JavaScript off; the script upgrades them into the drawer. */
const drawer = document.querySelector('[data-drawer]');
let opener = null;
const open = (e) => { e.preventDefault(); opener = e.currentTarget; drawer.open = true; drawer.querySelector('.act')?.focus({ preventScroll: true }); };
const close = () => { drawer.open = false; opener?.focus({ preventScroll: true }); opener = null; };
document.querySelectorAll('[data-open-drawer]').forEach((b) => b.addEventListener('click', open));
document.querySelectorAll('[data-close-drawer]').forEach((b) => b.addEventListener('click', close));
addEventListener('keydown', (e) => { if (e.key === 'Escape' && drawer.open) close(); });
</script>

</body>
</html>
