---
import { c, block, blocks, paras, photo, rating } from '../lib/content';
import '../styles/site.css';
import BookingMark from '../components/BookingMark.astro';
import AgodaMark from '../components/AgodaMark.astro';
import HostelworldMark from '../components/HostelworldMark.astro';
import PhoneMark from '../components/PhoneMark.astro';

const hw = rating('hostelworld'), bk = rating('booking'), gg = rating('google');
const intro = block('intro');
const [family, breakfast] = blocks('about');
const rooms = block('offer');
const [whatsHere, gettingHere] = blocks('info');
const marks = { hostelworld: HostelworldMark, booking: BookingMark, agoda: AgodaMark };
const platform = (l) => l.toLowerCase().includes('hostelworld') ? 'hostelworld' : l.toLowerCase().includes('agoda') ? 'agoda' : 'booking';
const site = (p) => p === 'hostelworld' ? 'Hostelworld' : p === 'booking' ? 'Booking.com' : 'Google';
const mapUrl = 'https://www.google.com/maps/search/KA%20Surf%20Hostel%20Ahangama/@5.9736,80.3639,17z?hl=en';
const si = c.stayInfo;
/* four moments in a day here, each with a photograph the hostel actually has */
const day = [
  { id: 'img-013', when: 'Breakfast', line: 'Rotis, hoppers, pancakes, eggs, a fruit platter, a vegan option if you need one. It changes every morning.' },
  { id: 'img-019', when: 'Midday',    line: 'Kabalana Beach is a five-minute walk — close enough to check the surf before breakfast and come back wet.' },
  { id: 'img-016', when: 'Sundown',   line: 'A green garden and a chill zone. Free filtered water you can refill any time.' },
  { id: 'img-002', when: 'Dinner',    line: 'Guests keep using the same word for this place — family — and it is at its most obvious at the long table.' },
];
const prints = ['img-003', 'img-014', 'img-012', 'img-004', 'img-005', 'img-011', 'img-017', 'img-001', 'img-008', 'img-020'];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{c.businessName} — {c.tagline}</title>
<meta name="description" content={`${c.tagline}. ${paras(intro.body)[0]}`} />
<link rel="preload" href="fonts/newsreader.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>

<a class="sr" href="#book">Skip to booking</a>

<header class="head wrap">
  <h1 class="name">{c.businessName}</h1>
  <p class="where">Ahangama · Sri Lanka · five minutes from Kabalana</p>
</header>

<main class="wrap">

<!-- Today's card. The print inside it is capped at 360 px rendered; KA's best
     photograph is 576 px wide and has no business being bigger than this. -->
<section class="today" id="today">
  <figure class="shot">
    <img data-still src={photo(day[0].id).src} srcset={photo(day[0].id).srcset} sizes="380px"
         width={photo(day[0].id).width} height={photo(day[0].id).height} alt={photo(day[0].id).alt} fetchpriority="high" />
    <canvas data-day data-sources={JSON.stringify(day.map((d) => photo(d.id).src))} aria-hidden="true"></canvas>
    <figcaption class="when" data-when>{day[0].when}</figcaption>
  </figure>
  <div class="say">
    <p class="kicker">Today at KA</p>
    <h2 data-line>{day[0].line}</h2>
    <ul class="tags">
      {[hw, bk, gg].filter(Boolean).map((r) => <li class="tag"><b>{r.score}</b>/{r.scale} {site(r.platform)} · {r.count}</li>)}
    </ul>
    <a class="open" href="#book" data-open-drawer>Check dates</a>
  </div>
</section>

<section class="sec pin-grid pin-grid--2">
  <div class="card rise">
    <p class="kicker">Where it is</p>
    <h2>{intro.heading}</h2>
    {paras(intro.body).map((p) => <p>{p}</p>)}
  </div>
  <div class="card card--tint rise">
    <p class="kicker">Who runs it</p>
    <h2>{family.heading}</h2>
    {paras(family.body).map((p) => <p>{p}</p>)}
  </div>
</section>

<section class="sec">
  <p class="kicker" style="color:var(--chalk-dim)">Pinned to the wall</p>
  <div class="prints">
    {prints.map((id, i) => {
      const p = photo(id);
      return (
        <figure class={i % 3 === 1 ? 'print print--portrait' : 'print'}>
          <img src={p.src} srcset={p.srcset} sizes="(min-width: 720px) 210px, 45vw"
               width={p.width} height={p.height} alt={p.alt} loading="lazy" decoding="async" />
          <figcaption>{p.alt}</figcaption>
        </figure>
      );
    })}
  </div>
</section>

<section class="sec">
  <div class="card rise">
    <p class="kicker">Beds and rooms · {c.rooms.length} kinds</p>
    <h2>{rooms.heading}</h2>
    {paras(rooms.body).map((p) => <p>{p}</p>)}
  </div>
  <div class="rail" role="group" aria-label="Beds and rooms — scroll sideways">
    {c.rooms.map((r, i) => (
      <article class="bedcard">
        <span class="n">{String(i + 1).padStart(2, '0')}</span>
        <span class="what">{r.label}</span>
        <span class="detail">{r.beds}</span>
        <a class="go" href="#book" data-open-drawer>Check this bed</a>
      </article>
    ))}
  </div>
</section>

<section class="sec">
  <div class="card card--tint rise">
    <p class="kicker">Every morning</p>
    <h2>{breakfast.heading}</h2>
    {paras(breakfast.body).map((p) => <p>{p}</p>)}
  </div>
</section>

<section class="sec">
  <p class="kicker" style="color:var(--chalk-dim)">What is here</p>
  <ul class="labels">{c.amenities.map((a) => <li>{a.label}{a.note ? <em> — {a.note}</em> : null}</li>)}</ul>
</section>

<section class="sec">
  <p class="kicker" style="color:var(--chalk-dim)">What guests wrote · everyone uses the same word</p>
  <div class="quotes">
    {c.testimonials.map((t) => (
      <figure class="qcard">
        <blockquote>“{t.quote}”</blockquote>
        <figcaption>{t.author} — {t.source === 'booking' ? 'Booking.com' : t.source === 'hostelworld' ? 'Hostelworld' : t.source}</figcaption>
      </figure>
    ))}
  </div>
</section>

<section class="sec wave">
  <div class="card rise">
    <p class="kicker">The wave</p>
    <h2 style="max-width:14ch">Kabalana, five minutes on foot</h2>
    <p>{c.spot}</p>
    <p class="kicker" style="margin-top:28px">Getting here</p>
    {paras(gettingHere.body).map((p) => <p>{p}</p>)}
    <ul class="facts">
      <li><span class="k">Check in</span><span>{si.checkInFrom}–{si.checkInTo}</span></li>
      <li><span class="k">Check out</span><span>by {si.checkOutTo}</span></li>
      <li><span class="k">Address</span><span>{c.contact.address}</span></li>
      <li><span class="k">Good to know</span><span>{si.note}</span></li>
    </ul>
  </div>
  <div class="widget">
    <iframe src="https://rosa.surf/widget/?spot=kabalana&theme=light&units=metric"
      title="Rosa surf forecast - Kabalana" width="100%" height="500"
      style="max-width:420px;border:0;border-radius:12px;display:block"
      loading="lazy" referrerpolicy="strict-origin-when-cross-origin"
      sandbox="allow-scripts allow-popups allow-popups-to-escape-sandbox allow-same-origin"></iframe>
    <p>Kabalana today — rosa.surf</p>
  </div>
</section>

<footer class="foot" id="book">
  <div class="cols">
    <div>
      <h3>Where</h3>
      <p>{c.contact.address}</p>
      <p><a class="link" href={mapUrl} rel="noopener">Open in Google Maps</a></p>
    </div>
    <div>
      <h3>Reception</h3>
      <p><a class="link" href={`tel:${c.contact.phone}`}>{c.contact.phone}</a></p>
      <p>Open 24 hours.</p>
    </div>
    <div>
      <h3>Book</h3>
      <ul>{c.bookingLinks.map((b) => <li><a class="link" href={b.url} rel="noopener">{b.label}</a></li>)}</ul>
    </div>
  </div>
  <p class="legal">Mockup 2 of 3 — “interactive”, on the noticeboard archetype (see <code>concepts.md</code>). Every fact on this page comes from the dossier harvested on 19 September 2026; see notes.md. Photographs are the hostel's own and never render wider than a postcard; the shimmer over today's print is drawn in WebGL and alters nothing in the photograph.</p>
</footer>

</main>

<details class="drawer" data-drawer>
  <summary>Booking</summary>
  <div class="backdrop" data-close-drawer></div>
  <div class="panel">
    <div class="inner">
      <button class="close" type="button" data-close-drawer>Close</button>
      <h2>Check dates</h2>
      <p>KA sells its beds and rooms on three listings, and they hold the live prices. Its best score — {hw?.score}/10 across {hw?.count} reviews — is on Hostelworld. Reception answers the phone around the clock.</p>
      <div class="book-row">
        {c.bookingLinks.map((b, i) => {
          const Mark = marks[platform(b.label)];
          return <a class={i === 0 ? 'book-card book-card--first' : 'book-card'} href={b.url} rel="noopener"><Mark light={i === 0} /> {site(platform(b.label))}</a>;
        })}
        <a class="book-card" href={`tel:${c.contact.phone}`}><PhoneMark /> Call</a>
      </div>
    </div>
  </div>
</details>

<nav class="mobile-dock" aria-label="Book">
  <a href="#book" data-open-drawer>Check dates</a>
  <a class="alt" href={`tel:${c.contact.phone}`}>Call</a>
</nav>

<script>
import { startDay } from '../scripts/day.js';

const DAY = [
  { when: 'Breakfast', line: 'Rotis, hoppers, pancakes, eggs, a fruit platter, a vegan option if you need one. It changes every morning.' },
  { when: 'Midday',    line: 'Kabalana Beach is a five-minute walk — close enough to check the surf before breakfast and come back wet.' },
  { when: 'Sundown',   line: 'A green garden and a chill zone. Free filtered water you can refill any time.' },
  { when: 'Dinner',    line: 'Guests keep using the same word for this place — family — and it is at its most obvious at the long table.' },
];

const canvas = document.querySelector('[data-day]');
const when = document.querySelector('[data-when]');
const line = document.querySelector('[data-line]');
const card = document.querySelector('.today');
const day = canvas && startDay(canvas, JSON.parse(canvas.dataset.sources));
if (day) {
  canvas.classList.add('on');
  let last = -1;
  const onScroll = () => {
    /* the day turns over the first three screens of scroll */
    const travel = innerHeight * 2.4;
    const p = Math.min(1, Math.max(0, (-card.getBoundingClientRect().top + innerHeight * 0.25) / travel));
    day.setProgress(p);
    const i = Math.min(DAY.length - 1, Math.round(p * (DAY.length - 1)));
    if (i !== last) { last = i; when.textContent = DAY[i].when; line.textContent = DAY[i].line; }
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
}

const io = new IntersectionObserver((es) => {
  for (const e of es) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
}, { rootMargin: '0px 0px -8%' });
document.querySelectorAll('.rise').forEach((el) => io.observe(el));

/* Triggers are real links to the footer booking block, so they work with
   JavaScript off; the script upgrades them into the drawer. */
const drawer = document.querySelector('[data-drawer]');
let opener = null;
const open = (e) => { e.preventDefault(); opener = e.currentTarget; drawer.open = true; drawer.querySelector('.book-card')?.focus({ preventScroll: true }); };
const close = () => { drawer.open = false; opener?.focus({ preventScroll: true }); opener = null; };
document.querySelectorAll('[data-open-drawer]').forEach((b) => b.addEventListener('click', open));
document.querySelectorAll('[data-close-drawer]').forEach((b) => b.addEventListener('click', close));
addEventListener('keydown', (e) => { if (e.key === 'Escape' && drawer.open) close(); });
</script>

</body>
</html>
