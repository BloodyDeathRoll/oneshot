---
/* Layday Surf Ahangama — "Inside", the picked 4e mockup (unique, round 7) ported to Astro.
   Every owner-editable word, number, link and photograph comes from src/tenant/content.json
   (schemas/site-content.md v0.4, REST shape); the layout, motion and interface wording are here. */
import css from '../styles/site.css?raw'
import js from '../scripts/site.js?raw'
import {
  content as c, pName, safeUrl, tel, phoneLabel, paras, sentences, scoreText, monthYear, readOn, photo,
  SITE, IS_PREVIEW, LD_TYPE, MAP_PIN, postalAddress, metaDescription,
} from '../lib/site.mjs'

const name = c.businessName
const blocks = c.copyBlocks ?? []
const slot = (s, i) => blocks.filter((b) => b.slot === s)[i] ?? null
const intro = slot('intro', 0), dorm = slot('about', 0), built = slot('about', 1), offer = slot('offer', 0)
const door = slot('info', 0), prac = slot('info', 1)
const offerP = paras(offer?.body)
/* the offer block's first paragraph sits under "The room"; the rest (the rates line) sits with the
   booking links, in the drawer and the footer berth (concepts.md §2; mockup notes, conflict 4) */
const rates = offerP.slice(1).join(' ')
const doorP = paras(door?.body)
const steps = [...sentences(doorP[0]).map((t) => ({ t, gap: false })), ...doorP.slice(1).map((t, i) => ({ t, gap: i === 0 }))]

const links = (c.bookingLinks ?? []).map((l) => ({ ...l, url: safeUrl(l.url) })).filter((l) => l.url)
const book = links[0]?.url ?? null
const phone = tel(c.contact?.phone), phoneText = phoneLabel(c.contact?.phone)
const mapUrl = safeUrl(c.contact?.mapUrl)
const address = c.contact?.address ?? ''
const addressLine = address.split('\n').join(', ')

const ratings = c.ratings ?? []
const r0 = ratings[0] ?? null
const urlFor = (platform) => safeUrl(ratings.find((r) => r.platform === platform)?.url)

const q = c.testimonials ?? []
const qBeth = q[0], qDoor = q[1], qGuests = q.slice(2)

const ph = (c.photos ?? []).map(photo)
const P = (i) => ph[i] ?? null
const pair = [P(2), P(3)].filter(Boolean)
const trioBuilt = [P(4), P(5), P(6)].filter(Boolean)
const trioWave = ph.slice(7).filter(Boolean)

const st = c.stayInfo ?? {}
const fcOn = c.forecast?.enabled && /^[a-z0-9-]+$/.test(c.forecast?.rosaSpotId ?? '')
const spotId = c.forecast?.rosaSpotId, spotName = c.forecast?.spotName || spotId

/* Head and structured data (station 4h). Absolute URLs (canonical, hreflang, og:url, og:image, JSON-LD
   @id/url/image, sitemap) exist only when the build is given SITE_URL; everything else stays relative.
   A preview build (IS_PREVIEW) adds the noindex meta and nothing else: canonical, hreflang and og:*
   still follow whatever SITE_URL it was given, so the preview's own links resolve. */
const site = SITE
const abs = (u) => (site ? new URL(u, site).href : null)
const postal = postalAddress(address)
const place = postal?.addressLocality ?? ''
/* brand first. "<name>, <town>" when the name lacks the town; this name already carries it
   ("… Ahangama"), so the second half is the intro heading (where it is), if the whole fits in 60. */
const second = place && !name.toLowerCase().includes(place.toLowerCase()) ? `, ${place}` : (intro?.heading ? ` · ${intro.heading}` : '')
const title = `${name}${second}`.length <= 60 ? `${name}${second}` : name
const desc = metaDescription([c.tagline, intro?.heading, sentences(paras(intro?.body)[0])[0]]) || (c.tagline ?? '').slice(0, 155)
const og = P(0)
const ld = {
  '@context': 'https://schema.org',
  '@type': LD_TYPE[c.businessType] ?? 'LocalBusiness',
  ...(site ? { '@id': `${site.href}#business`, url: site.href } : {}),
  name,
  ...(desc ? { description: desc } : {}),
  ...(site && ph.some(Boolean) ? { image: ph.filter(Boolean).map((p) => abs(p.src)) } : {}),
  ...(c.contact?.phone ? { telephone: c.contact.phone } : {}),
  ...(postal ? { address: postal } : {}),
  geo: { '@type': 'GeoCoordinates', latitude: MAP_PIN.lat, longitude: MAP_PIN.lon },
  ...(mapUrl ? { hasMap: mapUrl } : {}),
  ...(st.checkInFrom ? { checkinTime: st.checkInFrom } : {}),
  ...(st.checkOutTo ? { checkoutTime: st.checkOutTo } : {}),
  ...((c.amenities ?? []).length ? {
    amenityFeature: c.amenities.map((a) => ({
      '@type': 'LocationFeatureSpecification', name: a.note ? `${a.label} (${a.note})` : a.label, value: true,
    })),
  } : {}),
  ...((c.languagesSpoken ?? []).length ? { knowsLanguage: c.languagesSpoken } : {}),
  ...(links.length ? { sameAs: links.map((l) => l.url) } : {}),
}
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
{IS_PREVIEW && <meta name="robots" content="noindex, nofollow">}
{desc && <meta name="description" content={desc}>}
{site && <link rel="canonical" href={site.href}>}
{site && <link rel="alternate" hreflang="en" href={site.href}>}
{site && <link rel="alternate" hreflang="x-default" href={site.href}>}
<meta property="og:type" content="website">
<meta property="og:site_name" content={name}>
<meta property="og:title" content={title}>
{desc && <meta property="og:description" content={desc}>}
{site && <meta property="og:url" content={site.href}>}
{site && og && <meta property="og:image" content={abs(og.src)}>}
{site && og && <meta property="og:image:width" content={String(og.w)}>}
{site && og && <meta property="og:image:height" content={String(og.h)}>}
{site && og && og.alt && <meta property="og:image:alt" content={og.alt}>}
<meta name="twitter:card" content="summary">
<script is:inline>document.documentElement.classList.add('js')</script>
<link rel="preload" href="fonts/urbanist-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<style is:inline set:html={css}></style>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

<header class="top">
  <h1 class="name">{name}</h1>
  {phone && <a class="tel" href={phone}>{phoneText}</a>}
</header>

<main id="main" tabindex="-1">
<section class="inside" aria-labelledby="h-intro">
  <div class="stage" id="stage">
    <div class="plane p-ceil" aria-hidden="true"></div>
    <div class="plane p-left" aria-hidden="true"></div>
    <span class="lamp" aria-hidden="true"></span>
    <div class="wall" id="wall">
      <div class="niche" id="niche" aria-hidden="true"><i></i></div>
      <p class="hl" id="h-intro">{intro?.heading || name}</p>
      {c.tagline && <p class="tag">{c.tagline}</p>}
      {r0 && <p class="score">{safeUrl(r0.url) ? <a href={r0.url}>{scoreText(r0)}/{r0.scale} on {pName(r0.platform)}, {r0.count} reviews</a> : <Fragment>{scoreText(r0)}/{r0.scale} on {pName(r0.platform)}, {r0.count} reviews</Fragment>}{readOn(r0) && <span class="when">{readOn(r0)}</span>}</p>}
      <p class="act">
        {book && <a class="book" data-drawer href={book}>Check dates</a>}
        {phone && <a class="call" href={phone}>or call {phoneText}</a>}
      </p>
    </div>
  </div>
</section>

<section class="sec room" aria-labelledby="h-room">
  <div class="grid">
    {intro && <div class="lead">{paras(intro.body).map((t) => <p>{t}</p>)}</div>}
    {dorm?.heading && <h2 id="h-room">{dorm.heading}</h2>}
    {dorm && <div class="body b1">{paras(dorm.body).map((t) => <p>{t}</p>)}</div>}
    {P(0) && <picture><source type="image/webp" srcset={P(0).webp} sizes="(max-width:767px) calc(100vw - 40px), 512px"><img class="p18" src={P(0).src} srcset={P(0).jpg} sizes="(max-width:767px) calc(100vw - 40px), 512px" width={P(0).w} height={P(0).h} loading="lazy" decoding="async" alt={P(0).alt}></picture>}
    {P(1) && <picture><source type="image/webp" srcset={P(1).webp} sizes="(max-width:767px) calc(100vw - 40px), 640px"><img class="p12" src={P(1).src} srcset={P(1).jpg} sizes="(max-width:767px) calc(100vw - 40px), 640px" width={P(1).w} height={P(1).h} loading="lazy" decoding="async" alt={P(1).alt}></picture>}
    {offer && (
    <div class="offer">
      {offer.heading && <h3>{offer.heading}</h3>}
      {offerP[0] && <div class="body"><p>{offerP[0]}</p></div>}
      {(c.rooms ?? []).map((r) => (
        <div class="bed"><div><b>{r.label}</b>{r.beds && <span>{r.beds}</span>}</div>{book && <a data-drawer href={book}>check dates</a>}</div>
      ))}
    </div>
    )}
    {qBeth && <blockquote class="beth"><p>“{qBeth.quote}”</p><footer>{qBeth.author}, on {urlFor(qBeth.source) ? <a href={urlFor(qBeth.source)}>{pName(qBeth.source)}</a> : pName(qBeth.source)}{monthYear(qBeth.date) && `, ${monthYear(qBeth.date)}`}</footer></blockquote>}
    {pair.length > 0 && <div class="pair">{pair.map((p) => (
      <picture><source type="image/webp" srcset={p.webp} sizes="(max-width:767px) 50vw, 320px"><img src={p.src} srcset={p.jpg} sizes="(max-width:767px) 50vw, 320px" width={p.w} height={p.h} loading="lazy" decoding="async" alt={p.alt}></picture>
    ))}</div>}
  </div>
</section>

{door && (
<section class="sec door" id="door" aria-labelledby="h-door">
  <div class="grid">
    {door.heading && <h2 id="h-door">{door.heading}</h2>}
    <p class="steps">{steps.map((s) => <span class={s.gap ? 'gap' : undefined}>{s.t}</span>)}</p>
    <div class="side">
      {qDoor && <blockquote><p>“{qDoor.quote}”</p><footer>{qDoor.author}, on {urlFor(qDoor.source) ? <a href={urlFor(qDoor.source)}>{pName(qDoor.source)}</a> : pName(qDoor.source)}{monthYear(qDoor.date) && `, ${monthYear(qDoor.date)}`}</footer></blockquote>}
      {mapUrl && <a class="maplink" href={mapUrl}>Open the map</a>}
    </div>
  </div>
</section>
)}

{built && (
<section class="sec built" aria-labelledby="h-built">
  <div class="grid">
    {built.heading && <h2 id="h-built">{built.heading}</h2>}
    <div class="body">{paras(built.body).map((t) => <p>{t}</p>)}</div>
    {trioBuilt.length > 0 && <div class="trio">{trioBuilt.map((p) => (
      <picture><source type="image/webp" srcset={p.webp} sizes="(max-width:767px) 220px, 320px"><img src={p.src} srcset={p.jpg} sizes="(max-width:767px) 220px, 320px" width={p.w} height={p.h} loading="lazy" decoding="async" alt={p.alt}></picture>
    ))}</div>}
  </div>
</section>
)}

{(ratings.length > 0 || qGuests.length > 0) && (
<section class="sec guests" aria-label="Ratings and guest reviews">
  <div class="grid">
    {ratings.map((r) => (
      <div class="rate"><p class="n">{scoreText(r)}<small>/{r.scale}</small></p><p>{safeUrl(r.url) ? <a href={r.url}>{pName(r.platform)}</a> : pName(r.platform)}, {r.count} reviews{readOn(r) && <span class="when">{readOn(r)}</span>}</p></div>
    ))}
    {qGuests.map((t) => (
      <blockquote><p>“{t.quote}”</p><footer>{t.author}, on {urlFor(t.source) ? <a href={urlFor(t.source)}>{pName(t.source)}</a> : pName(t.source)}{monthYear(t.date) && `, ${monthYear(t.date)}`}</footer></blockquote>
    ))}
  </div>
</section>
)}

<section class="sec wave" aria-labelledby="h-wave">
  <div class="grid">
    {c.spot && <h2 id="h-wave" class="spot">{c.spot}</h2>}
    {fcOn && (
    <div class="fc" data-json={`https://rosa-data-opal.vercel.app/data/spots/${spotId}.json`} data-spot={spotName}>
      <div class="fc-now" aria-live="polite">
        <p class="credit-rosa"><a href={`https://rosa.surf/spot/${spotId}`}>Forecast for {spotName} by Rosa</a></p>
        <div class="live">
          <p class="now"><span class="nh">{' '}<small> m</small></span></p>
          <p class="nd"><span data-f="t"></span><span data-f="swell"></span><span data-f="wind"></span></p>
          <p class="upd" data-f="upd"></p>
        </div>
      </div>
      <div class="fc-rosa">
        <a class="fc-link" href={`https://rosa.surf/spot/${spotId}`}><span>See today's forecast for {spotName} on Rosa</span></a>
        <iframe
          data-src={`https://rosa.surf/widget/?spot=${spotId}&theme=light&units=metric`}
          title={`Rosa surf forecast - ${spotName}`}
          width="100%"
          height="500"
          style="max-width:420px;border:0;border-radius:16px;display:block"
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          sandbox="allow-scripts allow-popups allow-popups-to-escape-sandbox allow-same-origin"
        ></iframe>
      </div>
    </div>
    )}
    {trioWave.length > 0 && <div class="trio">{trioWave.map((p) => (
      <picture><source type="image/webp" srcset={p.webp} sizes="(max-width:767px) 220px, 320px"><img src={p.src} srcset={p.jpg} sizes="(max-width:767px) 220px, 320px" width={p.w} height={p.h} loading="lazy" decoding="async" alt={p.alt}></picture>
    ))}</div>}
  </div>
</section>

{prac && (
<section class="sec prac" aria-labelledby="h-prac">
  <div class="grid">
    {prac.heading && <h2 id="h-prac">{prac.heading}</h2>}
    {(st.checkInFrom || st.checkInTo || st.checkOutTo) && (
    <dl class="times">
      {st.checkInFrom && <div><dt>Check in from</dt><dd>{st.checkInFrom}</dd></div>}
      {st.checkInTo && <div><dt>Check in until</dt><dd>{st.checkInTo}</dd></div>}
      {st.checkOutTo && <div><dt>Check out by</dt><dd>{st.checkOutTo}</dd></div>}
    </dl>
    )}
    <div class="body">
      {paras(prac.body).map((t) => <p>{t}</p>)}
      {st.note && <p class="note">{st.note}</p>}
    </div>
    {(c.amenities ?? []).length > 0 && <ul class="amen">{c.amenities.map((a) => <li>{a.label}{a.note && <span>{a.note}</span>}</li>)}</ul>}
    {(address || mapUrl) && <p class="addr">{addressLine}{mapUrl && <a href={mapUrl}>Open the map</a>}</p>}
  </div>
</section>
)}
</main>

<footer class="end" aria-label="Check dates">
  <div class="berth">
    {rates && <p class="rates">{rates}</p>}
    {links.length > 0 && <ul>{links.map((l) => <li><a href={l.url}>{l.label}</a></li>)}</ul>}
    <p class="fine">{phone && <a href={phone}>Call {phoneText}</a>}{addressLine && <span>{addressLine}</span>}</p>
    <span class="ladder" aria-hidden="true"><b style="top:22%"></b><b style="top:50%"></b><b style="top:78%"></b></span>
  </div>
</footer>
<p class="foot"><span>{name}</span></p>

<canvas class="box" id="box" aria-hidden="true"></canvas>

<div class="dock" id="dock">
 <details>
  <summary><span class="book">Check dates</span></summary>
  <div class="panel">
    {links.map((l) => <a href={l.url}>{l.label}</a>)}
    {phone && <a href={phone}>Call {phoneText}</a>}
  </div>
 </details>
  {phone && <a class="mcall" href={phone}>Call</a>}
  <span class="ladder" id="ladder" aria-hidden="true"><b style="top:22%"></b><b style="top:50%"></b><b style="top:78%"></b></span>
</div>

<div class="drawer" id="drawer" role="dialog" aria-modal="true" aria-label="Check dates" hidden>
  {rates && <p class="rates">{rates}</p>}
  <ul>{links.map((l) => <li><a href={l.url}>{l.label}</a></li>)}</ul>
  {phone && <p class="dcall"><a href={phone}>Call {phoneText}</a></p>}
  <button class="x" type="button">Close</button>
</div>

<script is:inline set:html={js}></script>
<!-- 4h: structured data last, so its ~3 KB does not sit in front of the first paint (measured: +30 ms LCP in the head) -->
<script is:inline type="application/ld+json" set:html={JSON.stringify(ld).replace(/</g, '\\u003c')}></script>
</body>
</html>
