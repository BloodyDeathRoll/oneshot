---
import { c, block, blocks, paras, photo, rating } from '../lib/content';
import '../styles/site.css';
import BookingMark from '../components/BookingMark.astro';
import AgodaMark from '../components/AgodaMark.astro';
import HostelworldMark from '../components/HostelworldMark.astro';
import PhoneMark from '../components/PhoneMark.astro';

const hw = rating('hostelworld'), bk = rating('booking'), gg = rating('google');
const intro = block('intro');
const [oneDorm, newlyBuilt] = blocks('about');
const offer = block('offer');
const [finding, practical] = blocks('info');
const marks = { hostelworld: HostelworldMark, booking: BookingMark, agoda: AgodaMark };
const platform = (l) => l.toLowerCase().includes('hostelworld') ? 'hostelworld' : l.toLowerCase().includes('agoda') ? 'agoda' : 'booking';
const site = (p) => p === 'hostelworld' ? 'Hostelworld' : p === 'booking' ? 'Booking.com' : 'Google';
const mapUrl = 'https://www.google.com/maps/search/Layday%20Surf%20Ahangama/@5.9794134,80.350836,17z?hl=en';
const si = c.stayInfo;
const steps = [
  'Follow the map to Warnagiri, Welhengoda.',
  'There is a large black gate — open it.',
  'Through the gate there is a wooden platform.',
  'The door to Layday is on the right of the house.',
];
const cells = ['img-008', 'img-018', 'img-003', 'img-017'];
const cells2 = ['img-011', 'img-013', 'img-001', 'img-007'];
const room = c.rooms[0];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{c.businessName} — {c.tagline}</title>
<meta name="description" content={`${c.tagline}. ${paras(intro.body)[0]}`} />
<link rel="preload" href="fonts/syne.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>

<a class="sr" href="#book">Skip to booking</a>

<!-- The card. Everything a visitor needs to decide is inside it, above the
     fold: what it is, where it is, what people scored it, and where to book. -->
<article class="card">

  <div class="row row--spec">
    <div class="cell">
      <p class="kicker">Ahangama · Sri Lanka</p>
      <h1 class="name">Layday Surf</h1>
      <p class="spec">One air-conditioned dormitory, newly built, a two-minute walk from Kabalana. Run by the family who built it.</p>
      <p class="small">{room.note}</p>
    </div>
    <figure class="framed cell cell--pale">
      <img src={photo('img-012').src} srcset={photo('img-012').srcset} sizes="(min-width: 820px) 420px, 92vw"
           width={photo('img-012').width} height={photo('img-012').height} alt={photo('img-012').alt} fetchpriority="high" />
    </figure>
  </div>

  <div class="row row--3">
    {[hw, bk, gg].filter(Boolean).map((r, i) => (
      <div class={i === 1 ? 'cell cell--ochre' : 'cell'}>
        <p class="score">{r.score}<span> /{r.scale}</span></p>
        <p>{site(r.platform)} · {r.count} reviews</p>
      </div>
    ))}
  </div>

  <div class="row">
    <div class="cell" id="book">
      <div class="book">
        {c.bookingLinks.map((b, i) => {
          const Mark = marks[platform(b.label)];
          return <a class={i === 0 ? 'book-card book-card--first' : 'book-card'} href={b.url} rel="noopener"><Mark light={i === 0} /> {site(platform(b.label))}</a>;
        })}
        <a class="book-card" href={`tel:${c.contact.phone}`}><PhoneMark /> Call</a>
      </div>
      <p class="book-note">There is one dormitory, and these three listings hold its live prices and availability. The property does not take credit cards on arrival.</p>
    </div>
  </div>

  <!-- The directions. The dossier records that guests cannot find this place -
       an unmarked black gate - and that a map and directions on a site would
       fix it today. So they get the wall colour and a cell of their own. -->
  <div class="row row--2">
    <div class="cell cell--ochre">
      <p class="kicker" style="color:#5e5140">Finding the door</p>
      <h2>{finding.heading}</h2>
      <p>Guests have got lost here. Now you will not.</p>
      <p style="margin-top:14px"><a class="link" style="color:var(--ink)" href={mapUrl} rel="noopener">Open the map</a></p>
    </div>
    <div class="cell cell--ochre">
      <ol class="steps" style="margin-top:0">{steps.map((s) => <li>{s}</li>)}</ol>
    </div>
  </div>

  <div class="row row--2">
    <div class="cell">
      <p class="kicker">Where it is</p>
      <h2>{intro.heading}</h2>
    </div>
    <div class="cell">{paras(intro.body).map((p) => <p>{p}</p>)}</div>
  </div>

  <div class="row cell--flush">
    <div class="cells">
      {cells.map((id) => {
        const p = photo(id);
        return (
          <figure>
            <img src={p.src} srcset={p.srcset} sizes="(min-width: 820px) 25vw, 50vw"
                 width={p.width} height={p.height} alt={p.alt} loading="lazy" decoding="async" />
          </figure>
        );
      })}
    </div>
  </div>

  <div class="row row--2">
    <div class="cell">
      <p class="kicker">The room</p>
      <h2>{oneDorm.heading}</h2>
      {paras(oneDorm.body).map((p) => <p>{p}</p>)}
    </div>
    <div class="cell cell--pale">
      <p class="kicker">What is in it</p>
      <h2>{offer.heading}</h2>
      {paras(offer.body).map((p) => <p>{p}</p>)}
    </div>
  </div>

  <div class="row row--2">
    <div class="cell">
      <p class="kicker">Newly built</p>
      <h2>{newlyBuilt.heading}</h2>
      {paras(newlyBuilt.body).map((p) => <p>{p}</p>)}
    </div>
    <div class="cell cell--pale">
      <p class="kicker">Everything here</p>
      <ul class="amen">{c.amenities.map((a) => <li>{a.label}{a.note ? <span class="note"> — {a.note}</span> : null}</li>)}</ul>
    </div>
  </div>

  <div class="row cell--flush">
    <div class="cells">
      {cells2.map((id) => {
        const p = photo(id);
        return (
          <figure>
            <img src={p.src} srcset={p.srcset} sizes="(min-width: 820px) 25vw, 50vw"
                 width={p.width} height={p.height} alt={p.alt} loading="lazy" decoding="async" />
          </figure>
        );
      })}
    </div>
  </div>

  <div class="row row--2">
    {c.testimonials.slice(0, 2).map((t, i) => (
      <div class="cell cell--ink">
        {i === 0 ? <p class="kicker">What guests wrote</p> : null}
        <figure class="quote">
          <blockquote>“{t.quote}”</blockquote>
          <figcaption>{t.author} — {t.source === 'booking' ? 'Booking.com' : 'Hostelworld'}</figcaption>
        </figure>
      </div>
    ))}
  </div>
  <div class="row row--3">
    {c.testimonials.slice(2).map((t) => (
      <div class="cell">
        <figure class="quote">
          <blockquote>“{t.quote}”</blockquote>
          <figcaption>{t.author} — {t.source === 'booking' ? 'Booking.com' : 'Hostelworld'}</figcaption>
        </figure>
      </div>
    ))}
  </div>

  <div class="row row--2">
    <div class="cell">
      <p class="kicker">The wave</p>
      <h2 style="max-width:14ch">Kabalana, two minutes away</h2>
      <p>{c.spot}</p>
      <p class="kicker" style="margin-top:34px">Before you arrive</p>
      {paras(practical.body).map((p) => <p>{p}</p>)}
      <ul class="facts">
        <li><span class="k">Check in</span><span>{si.checkInFrom}–{si.checkInTo}</span></li>
        <li><span class="k">Check out</span><span>by {si.checkOutTo}</span></li>
        <li><span class="k">Address</span><span>{c.contact.address}</span></li>
        <li><span class="k">Good to know</span><span>{si.note}</span></li>
      </ul>
    </div>
    <div class="cell cell--pale">
      <p class="kicker">Today at Kabalana</p>
      <div class="widget">
        <iframe src="https://rosa.surf/widget/?spot=kabalana&theme=light&units=metric"
          title="Rosa surf forecast - Kabalana" width="100%" height="500"
          style="max-width:420px;border:0;border-radius:12px;display:block"
          loading="lazy" referrerpolicy="strict-origin-when-cross-origin"
          sandbox="allow-scripts allow-popups allow-popups-to-escape-sandbox allow-same-origin"></iframe>
        <p>Live forecast — rosa.surf</p>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="cell">
      <div class="cols">
        <div>
          <h3>Where</h3>
          <p>{c.contact.address}</p>
          <p><a class="link" href={mapUrl} rel="noopener">Open in Google Maps</a></p>
        </div>
        <div>
          <h3>Reception</h3>
          <p><a class="link" href={`tel:${c.contact.phone}`}>{c.contact.phone}</a></p>
          <p>Limited hours — check in {si.checkInFrom}–{si.checkInTo}.</p>
        </div>
        <div>
          <h3>Book</h3>
          <ul>{c.bookingLinks.map((b) => <li><a class="link" href={b.url} rel="noopener">{b.label}</a></li>)}</ul>
        </div>
      </div>
      <p class="legal" style="margin-top:28px">Mockup 1 of 3 — “calm”, on the printed-spec-card archetype (see <code>concepts.md</code>). Every fact on this page comes from the dossier harvested on 19 September 2026; see notes.md. Photographs are the hostel's own. No bed count is published anywhere, because the platforms contradict each other and the dossier leaves it unresolved.</p>
    </div>
  </div>

</article>

<nav class="mobile-dock" aria-label="Book">
  <a href={c.bookingLinks[0].url} rel="noopener">Check dates</a>
  <a class="alt" href={`tel:${c.contact.phone}`}>Call</a>
</nav>

</body>
</html>
