---
import { c, block, blocks, paras, photo, rating } from '../lib/content';
import '../styles/site.css';
import BookingMark from '../components/BookingMark.astro';
import AgodaMark from '../components/AgodaMark.astro';
import HostelworldMark from '../components/HostelworldMark.astro';
import PhoneMark from '../components/PhoneMark.astro';

const room = photo('img-012');
const hw = rating('hostelworld'), bk = rating('booking'), gg = rating('google');
const intro = block('intro');
const [oneDorm, newlyBuilt] = blocks('about');
const offer = block('offer');
const [finding, practical] = blocks('info');
const marks = { hostelworld: HostelworldMark, booking: BookingMark, agoda: AgodaMark };
const platform = (l) => l.toLowerCase().includes('hostelworld') ? 'hostelworld' : l.toLowerCase().includes('agoda') ? 'agoda' : 'booking';
const site = (p) => p === 'hostelworld' ? 'Hostelworld' : p === 'booking' ? 'Booking.com' : 'Google';
const mapUrl = 'https://www.google.com/maps/search/Layday%20Surf%20Ahangama/@5.9794134,80.350836,17z?hl=en';
const si = c.stayInfo;
const steps = [
  'Follow the map to Warnagiri, Welhengoda.',
  'There is a large black gate — open it.',
  'Through the gate there is a wooden platform.',
  'The door to Layday is on the right of the house.',
];
const plates = ['img-008', 'img-018', 'img-003', 'img-017', 'img-011', 'img-013', 'img-001', 'img-007', 'img-004', 'img-016', 'img-002', 'img-006'];
const bedNote = c.rooms[0].note;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{c.businessName} — {c.tagline}</title>
<meta name="description" content={`${c.tagline}. ${paras(intro.body)[0]}`} />
<link rel="preload" href="fonts/syne.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>

<a class="sr" href="#book">Skip to booking</a>

<article class="card">

  <!-- The card, with its photograph cell pinned while the light crosses it. -->
  <div class="spread">
    <div class="stack-rows">
      <div class="row">
        <div class="cell">
          <p class="kicker">Ahangama · Sri Lanka</p>
          <h1 class="name">Layday Surf</h1>
          <p class="spec">One air-conditioned dormitory, newly built, a two-minute walk from Kabalana. Run by the family who built it.</p>
          <p class="small">{bedNote}</p>
        </div>
      </div>

      <div class="row row--3">
        {[hw, bk, gg].filter(Boolean).map((r, i) => (
          <div class={i === 1 ? 'cell cell--ochre' : 'cell'}>
            <p class="score">{r.score}<span> /{r.scale}</span></p>
            <p>{site(r.platform)} · {r.count}</p>
          </div>
        ))}
      </div>

      <div class="row">
        <div class="cell" style="text-align:center">
          <a class="open-drawer" href="#book" data-open-drawer>Check dates</a>
          <p class="book-note">There is one dormitory, and three listings hold its live prices. The property does not take credit cards on arrival.</p>
        </div>
      </div>

      <div class="row row--2">
        <div class="cell cell--ochre">
          <p class="kicker" style="color:#5e5140">Finding the door</p>
          <h2>{finding.heading}</h2>
          <p>Guests have got lost here. Now you will not.</p>
          <p style="margin-top:14px"><a class="link" style="color:var(--ink)" href={mapUrl} rel="noopener">Open the map</a></p>
        </div>
        <div class="cell cell--ochre">
          <ol class="steps" style="margin-top:0">{steps.map((s) => <li>{s}</li>)}</ol>
        </div>
      </div>

      <div class="row">
        <div class="cell">
          <p class="kicker">Where it is</p>
          <h2 class="rise">{intro.heading}</h2>
          <div class="rise">{paras(intro.body).map((p) => <p>{p}</p>)}</div>
        </div>
      </div>

      <div class="row">
        <div class="cell cell--pale">
          <p class="kicker">The room</p>
          <h2 class="rise">{oneDorm.heading}</h2>
          <div class="rise">{paras(oneDorm.body).map((p) => <p>{p}</p>)}</div>
        </div>
      </div>
    </div>

    <div class="pin">
      <figure class="box" style="margin:0">
        <img src={room.src} srcset={room.srcset} sizes="(min-width: 820px) 46vw, 100vw"
             width={room.width} height={room.height} alt={room.alt} fetchpriority="high" />
        <canvas data-light data-src={room.src} aria-hidden="true"></canvas>
        <figcaption class="when" data-when>Morning</figcaption>
      </figure>
    </div>
  </div>

  <div class="row cell--flush">
    <div class="plates">
      {plates.map((id) => {
        const p = photo(id);
        return (
          <figure class="plate">
            <div class="frame" style={`--ar:${p.width}/${p.height}`}>
              <img src={p.src} srcset={p.srcset} sizes="(min-width: 900px) 25vw, 48vw"
                   width={p.width} height={p.height} alt={p.alt} loading="lazy" decoding="async" />
            </div>
          </figure>
        );
      })}
    </div>
  </div>

  <div class="row row--2">
    <div class="cell">
      <p class="kicker">What is in it</p>
      <h2 class="rise">{offer.heading}</h2>
      <div class="rise">{paras(offer.body).map((p) => <p>{p}</p>)}</div>
    </div>
    <div class="cell cell--pale">
      <p class="kicker">Everything here</p>
      <ul class="amen">{c.amenities.map((a) => <li>{a.label}{a.note ? <span class="note"> — {a.note}</span> : null}</li>)}</ul>
    </div>
  </div>

  <div class="row row--2">
    <div class="cell">
      <p class="kicker">Newly built</p>
      <h2 class="rise">{newlyBuilt.heading}</h2>
    </div>
    <div class="cell rise">{paras(newlyBuilt.body).map((p) => <p>{p}</p>)}</div>
  </div>

  <div class="row row--2">
    {c.testimonials.slice(0, 2).map((t, i) => (
      <div class="cell cell--ink">
        {i === 0 ? <p class="kicker">What guests wrote</p> : null}
        <figure class="quote">
          <blockquote>“{t.quote}”</blockquote>
          <figcaption>{t.author} — {t.source === 'booking' ? 'Booking.com' : 'Hostelworld'}</figcaption>
        </figure>
      </div>
    ))}
  </div>
  <div class="row row--3">
    {c.testimonials.slice(2).map((t) => (
      <div class="cell">
        <figure class="quote">
          <blockquote>“{t.quote}”</blockquote>
          <figcaption>{t.author} — {t.source === 'booking' ? 'Booking.com' : 'Hostelworld'}</figcaption>
        </figure>
      </div>
    ))}
  </div>

  <div class="row row--2">
    <div class="cell">
      <p class="kicker">The wave</p>
      <h2 style="max-width:14ch">Kabalana, two minutes away</h2>
      <p>{c.spot}</p>
      <p class="kicker" style="margin-top:34px">Before you arrive</p>
      {paras(practical.body).map((p) => <p>{p}</p>)}
      <ul class="facts">
        <li><span class="k">Check in</span><span>{si.checkInFrom}–{si.checkInTo}</span></li>
        <li><span class="k">Check out</span><span>by {si.checkOutTo}</span></li>
        <li><span class="k">Address</span><span>{c.contact.address}</span></li>
        <li><span class="k">Good to know</span><span>{si.note}</span></li>
      </ul>
    </div>
    <div class="cell cell--pale">
      <p class="kicker">Today at Kabalana</p>
      <div class="widget">
        <iframe src="https://rosa.surf/widget/?spot=kabalana&theme=light&units=metric"
          title="Rosa surf forecast - Kabalana" width="100%" height="500"
          style="max-width:420px;border:0;border-radius:12px;display:block"
          loading="lazy" referrerpolicy="strict-origin-when-cross-origin"
          sandbox="allow-scripts allow-popups allow-popups-to-escape-sandbox allow-same-origin"></iframe>
        <p>Live forecast — rosa.surf</p>
      </div>
    </div>
  </div>

  <div class="row" id="book">
    <div class="cell">
      <div class="cols">
        <div>
          <h3>Where</h3>
          <p>{c.contact.address}</p>
          <p><a class="link" href={mapUrl} rel="noopener">Open in Google Maps</a></p>
        </div>
        <div>
          <h3>Reception</h3>
          <p><a class="link" href={`tel:${c.contact.phone}`}>{c.contact.phone}</a></p>
          <p>Limited hours — check in {si.checkInFrom}–{si.checkInTo}.</p>
        </div>
        <div>
          <h3>Book</h3>
          <ul>{c.bookingLinks.map((b) => <li><a class="link" href={b.url} rel="noopener">{b.label}</a></li>)}</ul>
        </div>
      </div>
      <p class="legal" style="margin-top:28px">Mockup 2 of 3 — “interactive”, on the printed-spec-card archetype (see <code>concepts.md</code>). Every fact on this page comes from the dossier harvested on 19 September 2026; see notes.md. Photographs are the hostel's own; the sunlight crossing the pinned one is drawn in WebGL and alters nothing in the photograph. No bed count is published anywhere.</p>
    </div>
  </div>

</article>

<details class="drawer" data-drawer>
  <summary>Booking</summary>
  <div class="backdrop" data-close-drawer></div>
  <div class="panel">
    <div class="inner">
      <button class="close" type="button" data-close-drawer>Close</button>
      <h2>Check dates</h2>
      <p>One dormitory, three listings holding its live prices. The property does not take credit cards on arrival, and reception keeps limited hours — check in {si.checkInFrom}–{si.checkInTo}.</p>
      <div class="book">
        {c.bookingLinks.map((b, i) => {
          const Mark = marks[platform(b.label)];
          return <a class={i === 0 ? 'book-card book-card--first' : 'book-card'} href={b.url} rel="noopener"><Mark light={i === 0} /> {site(platform(b.label))}</a>;
        })}
        <a class="book-card" href={`tel:${c.contact.phone}`}><PhoneMark /> Call</a>
      </div>
    </div>
  </div>
</details>

<nav class="mobile-dock" aria-label="Book">
  <a href="#book" data-open-drawer>Check dates</a>
  <a class="alt" href={`tel:${c.contact.phone}`}>Call</a>
</nav>

<script>
import { startLight } from '../scripts/light.js';

const canvas = document.querySelector('[data-light]');
const when = document.querySelector('[data-when]');
const pin = document.querySelector('.pin');
const light = canvas && startLight(canvas, canvas.dataset.src);
if (light) {
  canvas.classList.add('on');
  const labels = ['Morning', 'Midday', 'Afternoon', 'Evening'];
  let last = -1;
  const onScroll = () => {
    const r = pin.getBoundingClientRect();
    const travel = pin.offsetHeight - innerHeight;
    const p = travel > 0 ? Math.min(1, Math.max(0, -r.top / travel)) : 0;
    light.setSun(p);
    const i = Math.min(labels.length - 1, Math.round(p * (labels.length - 1)));
    if (i !== last) { last = i; when.textContent = labels[i]; }
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
}

const io = new IntersectionObserver((es) => {
  for (const e of es) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
}, { rootMargin: '0px 0px -8%' });
document.querySelectorAll('.rise').forEach((el) => io.observe(el));

/* Kube's parallax recipe (references.md #17), off at <= 767px and reduced motion */
const wide = matchMedia('(min-width: 768px)');
const calm = matchMedia('(prefers-reduced-motion: reduce)');
const movers = [...document.querySelectorAll('.plate')];
let ticking = false;
const par = () => {
  ticking = false;
  if (!wide.matches || calm.matches) return;
  const vh = innerHeight;
  for (const f of movers) {
    const r = f.getBoundingClientRect();
    if (r.bottom < -100 || r.top > vh + 100) continue;
    const k = Math.min(1, Math.max(0, (vh * 0.7 - r.top) / (vh * 0.7 + r.height * 0.3)));
    f.querySelector('img').style.transform = `translate3d(0, ${(-k * 4).toFixed(2)}rem, 0)`;
  }
};
addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(par); } }, { passive: true });
addEventListener('resize', par);
par();

/* Triggers are real links to the footer booking block, so they work with
   JavaScript off; the script upgrades them into the drawer. */
const drawer = document.querySelector('[data-drawer]');
let opener = null;
const open = (e) => { e.preventDefault(); opener = e.currentTarget; drawer.open = true; drawer.querySelector('.book-card')?.focus({ preventScroll: true }); };
const close = () => { drawer.open = false; opener?.focus({ preventScroll: true }); opener = null; };
document.querySelectorAll('[data-open-drawer]').forEach((b) => b.addEventListener('click', open));
document.querySelectorAll('[data-close-drawer]').forEach((b) => b.addEventListener('click', close));
addEventListener('keydown', (e) => { if (e.key === 'Escape' && drawer.open) close(); });
</script>

</body>
</html>
