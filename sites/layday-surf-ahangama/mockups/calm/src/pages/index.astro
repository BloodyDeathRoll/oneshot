---
import { c, block, blocks, paras, photo, rating } from '../lib/content';
import '../styles/site.css';
import BookingMark from '../components/BookingMark.astro';
import AgodaMark from '../components/AgodaMark.astro';
import HostelworldMark from '../components/HostelworldMark.astro';
import PhoneMark from '../components/PhoneMark.astro';

const hero = photo('img-012');
const hw = rating('hostelworld'), bk = rating('booking'), gg = rating('google');
const intro = block('intro');
const [oneDorm, newlyBuilt] = blocks('about');
const room = block('offer');
const [finding, practical] = blocks('info');
const gallery = ['img-008', 'img-018', 'img-003', 'img-017', 'img-011', 'img-013', 'img-001', 'img-007'];
const bands = { dorm: photo('img-009'), quotes: photo('img-010'), wave: photo('img-022') };
const marks = { hostelworld: HostelworldMark, booking: BookingMark, agoda: AgodaMark };
const platform = (l) => l.toLowerCase().includes('hostelworld') ? 'hostelworld' : l.toLowerCase().includes('agoda') ? 'agoda' : 'booking';
const mapUrl = 'https://www.google.com/maps/search/Layday%20Surf%20Ahangama/@5.9794134,80.350836,17z?hl=en';
const si = c.stayInfo;
/* The directions, split into the steps the copy already sets out. The words are
   the copy's; the numbering is layout. */
const steps = [
  'Follow the map to Warnagiri, Welhengoda.',
  'There is a large black gate — open it.',
  'Through the gate there is a wooden platform.',
  'The door to Layday is on the right of the house.',
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{c.businessName} — {c.tagline}</title>
<meta name="description" content={`${c.tagline}. ${paras(intro.body)[0]}`} />
<link rel="preload" href="fonts/syne.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>

<a class="sr" href="#book">Skip to booking</a>

<header class="site-head wrap">
  <div>
    <div class="name">Layday Surf</div>
    <div class="where">Ahangama · Sri Lanka</div>
  </div>
  <a class="btn head-book" href="#book">Check dates</a>
</header>

<section class="hero">
  <figure>
    <img src={hero.src} srcset={hero.srcset} sizes="100vw" width={hero.width} height={hero.height}
         alt={hero.alt} fetchpriority="high" />
    <div class="scrim"></div>
  </figure>
  <div class="words">
    <div class="wrap">
      <h1>{intro.heading}</h1>
      <p class="tagline">One dormitory, newly built, run by the family who built it.</p>
      <p class="scores">
        {hw && <span><b>{hw.score}</b>/{hw.scale} Hostelworld · {hw.count} reviews</span>}
        {bk && <span><b>{bk.score}</b>/{bk.scale} Booking.com · {bk.count}</span>}
        {gg && <span><b>{gg.score}</b>/{gg.scale} Google · {gg.count}</span>}
      </p>
    </div>
  </div>
</section>

<section class="dock" id="book">
  <div class="wrap inner">
    <div class="acts">
      {c.bookingLinks.map((b, i) => {
        const Mark = marks[platform(b.label)];
        return <a class={i === 0 ? 'btn btn--solid' : 'btn'} href={b.url} rel="noopener"><Mark light={i === 0} /> {b.label}</a>;
      })}
      <a class="btn" href={`tel:${c.contact.phone}`}><PhoneMark /> Call Layday</a>
    </div>
    <p class="note">There is one dormitory, and these three listings hold its live prices and availability. The property does not take credit cards on arrival.</p>
  </div>
</section>

<main>

<section class="sec wrap">
  <p class="eyebrow">Where it is</p>
  <div class="two-col">
    <h2>{c.tagline}</h2>
    <div>{paras(intro.body).map((p, i) => <p class={i === 0 ? 'lead' : ''}>{p}</p>)}</div>
  </div>
</section>

<!-- The black gate. The dossier's own gap note says guests cannot find this
     place; a map and directions on a site would fix it today. So they get the
     wall colour and a line of their own. -->
<section class="panel">
  <div class="wrap">
    <p class="eyebrow" style="color:#5e5140">Finding the door</p>
    <h2>{finding.heading}</h2>
    <ol class="steps">{steps.map((s) => <li>{s}</li>)}</ol>
    <p style="margin-top:22px"><a class="link" style="color:var(--ink)" href={mapUrl} rel="noopener">Open the map</a> — guests have got lost here. Now you will not.</p>
  </div>
</section>

<section class="sec wrap">
  <p class="eyebrow">The room</p>
  <div class="two-col">
    <h2>{oneDorm.heading}</h2>
    <div>{paras(oneDorm.body).map((p, i) => <p class={i === 0 ? 'lead' : ''}>{p}</p>)}</div>
  </div>
  <div class="run-in">
    {c.rooms.map((r) => (
      <div class="room">
        <span class="label">{r.label}</span>
        <span class="beds">{r.beds}</span>
        {r.note ? <span class="note">{r.note}</span> : null}
      </div>
    ))}
  </div>
  <div class="two-col run-in">
    <h2>{room.heading}</h2>
    <div>{paras(room.body).map((p) => <p>{p}</p>)}</div>
  </div>
</section>

<div class="band" role="img" aria-label={bands.dorm.alt} style={`background-image:url(${bands.dorm.src})`}></div>

<section class="sec wrap">
  <p class="eyebrow">Newly built</p>
  <div class="two-col">
    <h2>{newlyBuilt.heading}</h2>
    <div>{paras(newlyBuilt.body).map((p, i) => <p class={i === 0 ? 'lead' : ''}>{p}</p>)}</div>
  </div>
  <div class="gallery run-in">
    {gallery.map((id) => {
      const p = photo(id);
      return <img src={p.src} srcset={p.srcset} sizes="(min-width: 720px) 24vw, 46vw"
                  width={p.width} height={p.height} alt={p.alt} loading="lazy" decoding="async" />;
    })}
  </div>
</section>

<section class="sec wrap">
  <p class="eyebrow">What is here</p>
  <ul class="amen">{c.amenities.map((a) => <li>{a.label}{a.note ? <span class="note"> — {a.note}</span> : null}</li>)}</ul>
</section>

<div class="band" role="img" aria-label={bands.quotes.alt} style={`background-image:url(${bands.quotes.src})`}></div>

<section class="sec wrap">
  <p class="eyebrow">What guests wrote</p>
  <h2 style="max-width:18ch">Small, and that is the point</h2>
  <div class="quotes run-in">
    {c.testimonials.map((t) => (
      <figure class="quote">
        <blockquote>“{t.quote}”</blockquote>
        <figcaption>{t.author} — on {t.source === 'booking' ? 'Booking.com' : t.source === 'hostelworld' ? 'Hostelworld' : t.source}</figcaption>
      </figure>
    ))}
  </div>
</section>

<div class="band" role="img" aria-label={bands.wave.alt} style={`background-image:url(${bands.wave.src})`}></div>

<section class="sec wrap">
  <p class="eyebrow">The wave</p>
  <div class="wave">
    <p class="lead">{c.spot}</p>
    <div class="widget">
      <iframe
        src="https://rosa.surf/widget/?spot=kabalana&theme=light&units=metric"
        title="Rosa surf forecast - Kabalana"
        width="100%" height="500"
        style="max-width:420px;border:0;border-radius:16px;display:block"
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
        sandbox="allow-scripts allow-popups allow-popups-to-escape-sandbox allow-same-origin"
      ></iframe>
      <p>Live forecast for Kabalana from rosa.surf.</p>
    </div>
  </div>
</section>

<section class="sec wrap">
  <p class="eyebrow">Before you arrive</p>
  <div class="two-col">
    <h2>{practical.heading}</h2>
    <div>
      {paras(practical.body).map((p) => <p>{p}</p>)}
      <ul class="facts">
        <li><span class="k">Check in</span><span>{si.checkInFrom}–{si.checkInTo}</span></li>
        <li><span class="k">Check out</span><span>by {si.checkOutTo}</span></li>
        <li><span class="k">Address</span><span>{c.contact.address}</span></li>
        <li><span class="k">Good to know</span><span>{si.note}</span></li>
      </ul>
    </div>
  </div>
</section>

</main>

<footer class="foot">
  <div class="wrap">
    <div class="cols">
      <div>
        <h3>Where</h3>
        <p>{c.contact.address}</p>
        <p><a class="link" href={mapUrl} rel="noopener">Open in Google Maps</a></p>
      </div>
      <div>
        <h3>Reception</h3>
        <p><a class="link" href={`tel:${c.contact.phone}`}>{c.contact.phone}</a></p>
        <p>Limited hours — check in {si.checkInFrom}–{si.checkInTo}.</p>
      </div>
      <div>
        <h3>Book</h3>
        <ul>{c.bookingLinks.map((b) => <li><a class="link" href={b.url} rel="noopener">{b.label}</a></li>)}</ul>
      </div>
    </div>
    <p class="legal">Mockup 1 of 3 — “calm”. Every fact on this page comes from the dossier harvested on 19 September 2026; see notes.md. Photographs are the hostel's own.</p>
  </div>
</footer>

<nav class="mobile-dock" aria-label="Book">
  <a href={c.bookingLinks[0].url} rel="noopener">Check dates</a>
  <a class="alt" href={`tel:${c.contact.phone}`}>Call</a>
</nav>

</body>
</html>
