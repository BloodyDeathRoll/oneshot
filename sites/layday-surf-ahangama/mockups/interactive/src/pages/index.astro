---
import { c, block, blocks, paras, photo, rating } from '../lib/content';
import '../styles/site.css';
import BookingMark from '../components/BookingMark.astro';
import AgodaMark from '../components/AgodaMark.astro';
import HostelworldMark from '../components/HostelworldMark.astro';
import PhoneMark from '../components/PhoneMark.astro';

const room = photo('img-012');
const hw = rating('hostelworld'), bk = rating('booking'), gg = rating('google');
const intro = block('intro');
const [oneDorm, newlyBuilt] = blocks('about');
const offer = block('offer');
const [finding, practical] = blocks('info');
const shapes = ['', 'plate--tall', 'plate--wide'];
const plates = ['img-008', 'img-018', 'img-003', 'img-017', 'img-011', 'img-013', 'img-001', 'img-004', 'img-016'];
const bands = { gate: photo('img-007'), quotes: photo('img-010'), wave: photo('img-020') };
const marks = { hostelworld: HostelworldMark, booking: BookingMark, agoda: AgodaMark };
const platform = (l) => l.toLowerCase().includes('hostelworld') ? 'hostelworld' : l.toLowerCase().includes('agoda') ? 'agoda' : 'booking';
const mapUrl = 'https://www.google.com/maps/search/Layday%20Surf%20Ahangama/@5.9794134,80.350836,17z?hl=en';
const si = c.stayInfo;
const steps = [
  'Follow the map to Warnagiri, Welhengoda.',
  'There is a large black gate — open it.',
  'Through the gate there is a wooden platform.',
  'The door to Layday is on the right of the house.',
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{c.businessName} — {c.tagline}</title>
<meta name="description" content={`${c.tagline}. ${paras(intro.body)[0]}`} />
<link rel="preload" href="fonts/syne.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>

<a class="sr" href="#book">Skip to booking</a>

<header class="site-head fixed">
  <div>
    <div class="name">Layday Surf</div>
    <div class="where">Ahangama · Sri Lanka</div>
  </div>
  <a class="book-open" href="#book" data-open-drawer>Check dates</a>
</header>

<!-- The room, pinned, while the sun crosses the plaster. -->
<section class="room-pin">
  <div class="stick">
    <img class="still" src={room.src} srcset={room.srcset} sizes="100vw"
         width={room.width} height={room.height} alt={room.alt} fetchpriority="high" />
    <canvas data-light data-src={room.src} aria-hidden="true"></canvas>
    <div class="veil"></div>
    <p class="clock" data-clock>Morning</p>
    <div class="words">
      <div class="wrap">
        <h1>{intro.heading}</h1>
        <p class="tagline">One dormitory, newly built, run by the family who built it. It is quiet.</p>
        <p class="scores">
          {hw && <span><b>{hw.score}</b>/{hw.scale} Hostelworld · {hw.count}</span>}
          {bk && <span><b>{bk.score}</b>/{bk.scale} Booking.com · {bk.count}</span>}
          {gg && <span><b>{gg.score}</b>/{gg.scale} Google · {gg.count}</span>}
        </p>
      </div>
    </div>
  </div>
</section>

<main>

<section class="sec wrap">
  <p class="eyebrow">Where it is</p>
  <div class="two-col">
    <h2 class="rise">{c.tagline}</h2>
    <div class="rise">{paras(intro.body).map((p, i) => <p class={i === 0 ? 'lead' : ''}>{p}</p>)}</div>
  </div>
</section>

<figure class="band">
  <img src={bands.gate.src} srcset={bands.gate.srcset} sizes="100vw" width={bands.gate.width}
       height={bands.gate.height} alt={bands.gate.alt} loading="lazy" decoding="async" />
  <figcaption>The path in</figcaption>
</figure>

<section class="panel">
  <div class="wrap">
    <p class="eyebrow" style="color:#5e5140">Finding the door</p>
    <h2>{finding.heading}</h2>
    <ol class="steps">{steps.map((s) => <li>{s}</li>)}</ol>
    <p style="margin-top:22px"><a class="link" style="color:var(--ink)" href={mapUrl} rel="noopener">Open the map</a> — guests have got lost here. Now you will not.</p>
  </div>
</section>

<section class="sec wrap">
  <p class="eyebrow">The room</p>
  <div class="two-col">
    <h2 class="rise">{oneDorm.heading}</h2>
    <div class="rise">{paras(oneDorm.body).map((p, i) => <p class={i === 0 ? 'lead' : ''}>{p}</p>)}</div>
  </div>
  <div class="run-in">
    {c.rooms.map((r) => (
      <div class="room">
        <span class="label">{r.label}</span>
        <span class="beds">{r.beds}</span>
        {r.note ? <span class="note">{r.note}</span> : null}
        <a class="link" href="#book" data-open-drawer style="margin-top:10px;font-size:12px;letter-spacing:.12em;text-transform:uppercase">Check this bed</a>
      </div>
    ))}
  </div>
  <div class="two-col run-in">
    <h2 class="rise">{offer.heading}</h2>
    <div class="rise">{paras(offer.body).map((p) => <p>{p}</p>)}</div>
  </div>
</section>

<section class="sec wrap">
  <p class="eyebrow">The place</p>
  <div class="plates">
    {plates.map((id, i) => {
      const p = photo(id);
      return (
        <figure class={`plate ${shapes[i % shapes.length]}`}>
          <div class="frame">
            <img src={p.src} srcset={p.srcset} sizes="(min-width: 1000px) 32vw, (min-width: 620px) 48vw, 92vw"
                 width={p.width} height={p.height} alt={p.alt} loading="lazy" decoding="async" />
          </div>
          <figcaption>{p.alt}</figcaption>
        </figure>
      );
    })}
  </div>
</section>

<section class="sec wrap">
  <p class="eyebrow">Newly built</p>
  <div class="two-col">
    <h2 class="rise">{newlyBuilt.heading}</h2>
    <div class="rise">{paras(newlyBuilt.body).map((p, i) => <p class={i === 0 ? 'lead' : ''}>{p}</p>)}</div>
  </div>
  <ul class="amen run-in">{c.amenities.map((a) => <li>{a.label}{a.note ? <span class="note"> — {a.note}</span> : null}</li>)}</ul>
</section>

<figure class="band">
  <img src={bands.quotes.src} srcset={bands.quotes.srcset} sizes="100vw" width={bands.quotes.width}
       height={bands.quotes.height} alt={bands.quotes.alt} loading="lazy" decoding="async" />
  <figcaption>The garden walkway</figcaption>
</figure>

<section class="sec wrap">
  <p class="eyebrow">What guests wrote</p>
  <h2 class="rise" style="max-width:18ch">Small, and that is the point</h2>
  <div class="quotes run-in">
    {c.testimonials.map((t) => (
      <figure class="quote rise">
        <blockquote>“{t.quote}”</blockquote>
        <figcaption>{t.author} — on {t.source === 'booking' ? 'Booking.com' : t.source === 'hostelworld' ? 'Hostelworld' : t.source}</figcaption>
      </figure>
    ))}
  </div>
</section>

<section class="sec wrap">
  <div class="wave">
    <div>
      <p class="eyebrow">The wave</p>
      <p class="lead rise">{c.spot}</p>
      <p class="eyebrow" style="margin-top:42px">Before you arrive</p>
      {paras(practical.body).map((p) => <p class="rise">{p}</p>)}
      <ul class="facts">
        <li><span class="k">Check in</span><span>{si.checkInFrom}–{si.checkInTo}</span></li>
        <li><span class="k">Check out</span><span>by {si.checkOutTo}</span></li>
        <li><span class="k">Address</span><span>{c.contact.address}</span></li>
        <li><span class="k">Good to know</span><span>{si.note}</span></li>
      </ul>
    </div>
    <div class="widget">
      <iframe
        src="https://rosa.surf/widget/?spot=kabalana&theme=light&units=metric"
        title="Rosa surf forecast - Kabalana"
        width="100%" height="500"
        style="max-width:420px;border:0;border-radius:16px;display:block"
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
        sandbox="allow-scripts allow-popups allow-popups-to-escape-sandbox allow-same-origin"
      ></iframe>
      <p>Live forecast for Kabalana — rosa.surf</p>
    </div>
  </div>
</section>

</main>

<footer class="foot" id="book">
  <div class="wrap">
    <div class="cols">
      <div>
        <h3>Where</h3>
        <p>{c.contact.address}</p>
        <p><a class="link" href={mapUrl} rel="noopener">Open in Google Maps</a></p>
      </div>
      <div>
        <h3>Reception</h3>
        <p><a class="link" href={`tel:${c.contact.phone}`}>{c.contact.phone}</a></p>
        <p>Limited hours — check in {si.checkInFrom}–{si.checkInTo}.</p>
      </div>
      <div>
        <h3>Book</h3>
        <ul>{c.bookingLinks.map((b) => <li><a class="link" href={b.url} rel="noopener">{b.label}</a></li>)}</ul>
      </div>
    </div>
    <p class="legal">Mockup 2 of 3 — “interactive”. Every fact on this page comes from the dossier harvested on 19 September 2026; see notes.md. Photographs are the hostel's own; the sunlight crossing the first one is drawn in WebGL and alters nothing in the photograph.</p>
  </div>
</footer>

<details class="drawer" data-drawer>
  <summary>Booking</summary>
  <div class="backdrop" data-close-drawer></div>
  <div class="panel">
    <div class="inner">
      <button class="close" type="button" data-close-drawer>Close</button>
      <h2>Check dates</h2>
      <p>There is one dormitory, and these three listings hold its live prices. The property does not take credit cards on arrival, and reception keeps limited hours — check in {si.checkInFrom}–{si.checkInTo}.</p>
      <div class="acts">
        {c.bookingLinks.map((b, i) => {
          const Mark = marks[platform(b.label)];
          return <a class={i === 0 ? 'act act--rust' : 'act'} href={b.url} rel="noopener"><Mark light={i === 0} /> {b.label}</a>;
        })}
        <a class="act" href={`tel:${c.contact.phone}`}><PhoneMark /> Call {c.contact.phone}</a>
      </div>
    </div>
  </div>
</details>

<nav class="mobile-dock" aria-label="Book">
  <a href="#book" data-open-drawer>Check dates</a>
  <a class="alt" href={`tel:${c.contact.phone}`}>Call</a>
</nav>

<script>
import { startLight } from '../scripts/light.js';

const canvas = document.querySelector('[data-light]');
const clock = document.querySelector('[data-clock]');
const light = canvas && startLight(canvas, canvas.dataset.src);
if (light) {
  canvas.classList.add('on');
  const section = document.querySelector('.room-pin');
  const labels = ['Morning', 'Midday', 'Afternoon', 'Evening'];
  const onScroll = () => {
    const travel = section.offsetHeight - innerHeight;
    const p = travel > 0 ? Math.min(1, Math.max(0, -section.getBoundingClientRect().top / travel)) : 0;
    light.setSun(p);
    if (clock) clock.textContent = labels[Math.min(labels.length - 1, Math.round(p * (labels.length - 1)))];
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
}

const head = document.querySelector('.site-head');
const pin = document.querySelector('.room-pin');
const solid = () => head.classList.toggle('solid', pin.getBoundingClientRect().bottom <= 78);
addEventListener('scroll', solid, { passive: true });
solid();

const io = new IntersectionObserver((es) => {
  for (const e of es) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
}, { rootMargin: '0px 0px -8%' });
document.querySelectorAll('.rise').forEach((el) => io.observe(el));

/* Kube's parallax recipe (references.md #17), off at <= 767px and reduced motion */
const wide = matchMedia('(min-width: 768px)');
const calm = matchMedia('(prefers-reduced-motion: reduce)');
const movers = [...document.querySelectorAll('.plate, .band')];
let ticking = false;
const par = () => {
  ticking = false;
  if (!wide.matches || calm.matches) return;
  const vh = innerHeight;
  for (const f of movers) {
    const r = f.getBoundingClientRect();
    if (r.bottom < -100 || r.top > vh + 100) continue;
    const k = Math.min(1, Math.max(0, (vh * 0.7 - r.top) / (vh * 0.7 + r.height * 0.3)));
    const amt = f.classList.contains('band') ? 5 : 4;
    f.querySelector('img').style.transform = `translate3d(0, ${(-k * amt).toFixed(2)}rem, 0)`;
  }
};
addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(par); } }, { passive: true });
addEventListener('resize', par);
par();

/* Triggers are real links to the footer booking block, so they work with
   JavaScript off; the script upgrades them into the drawer. */
const drawer = document.querySelector('[data-drawer]');
let opener = null;
const open = (e) => { e.preventDefault(); opener = e.currentTarget; drawer.open = true; drawer.querySelector('.act')?.focus({ preventScroll: true }); };
const close = () => { drawer.open = false; opener?.focus({ preventScroll: true }); opener = null; };
document.querySelectorAll('[data-open-drawer]').forEach((b) => b.addEventListener('click', open));
document.querySelectorAll('[data-close-drawer]').forEach((b) => b.addEventListener('click', close));
addEventListener('keydown', (e) => { if (e.key === 'Escape' && drawer.open) close(); });
</script>

</body>
</html>
