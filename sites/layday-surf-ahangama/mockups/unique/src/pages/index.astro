---
import { c, block, blocks, paras, photo, rating } from '../lib/content';
import '../styles/site.css';
import BookingMark from '../components/BookingMark.astro';
import AgodaMark from '../components/AgodaMark.astro';
import HostelworldMark from '../components/HostelworldMark.astro';
import PhoneMark from '../components/PhoneMark.astro';

const wall = photo('img-009');
const hw = rating('hostelworld'), bk = rating('booking'), gg = rating('google');
const intro = block('intro');
const [oneDorm, newlyBuilt] = blocks('about');
const offer = block('offer');
const [finding, practical] = blocks('info');
const run = ['img-012', 'img-008', 'img-018', 'img-002', 'img-003', 'img-017', 'img-011', 'img-013', 'img-007', 'img-022'];
const marks = { hostelworld: HostelworldMark, booking: BookingMark, agoda: AgodaMark };
const platform = (l) => l.toLowerCase().includes('hostelworld') ? 'hostelworld' : l.toLowerCase().includes('agoda') ? 'agoda' : 'booking';
const mapUrl = 'https://www.google.com/maps/search/Layday%20Surf%20Ahangama/@5.9794134,80.350836,17z?hl=en';
const si = c.stayInfo;
const steps = [
  'Follow the map to Warnagiri, Welhengoda.',
  'There is a large black gate — open it.',
  'Through the gate there is a wooden platform.',
  'The door to Layday is on the right of the house.',
];
const label = (p) => p === 'hostelworld' ? 'Hostelworld' : p === 'booking' ? 'Booking.com' : 'Google';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{c.businessName} — {c.tagline}</title>
<meta name="description" content={`${c.tagline}. ${paras(intro.body)[0]}`} />
<link rel="preload" href="fonts/syne.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>

<a class="sr" href="#book">Skip to booking</a>

<div class="frame-out">

  <header class="site-head">
    <span class="name">Layday Surf · Ahangama</span>
    <a class="book-open" href="#book" data-open-drawer>Check dates</a>
  </header>

  <!-- The wall, with the garden moving across it. -->
  <section class="wall">
    <img class="still" src={wall.src} srcset={wall.srcset} sizes="100vw"
         width={wall.width} height={wall.height} alt={wall.alt} fetchpriority="high" />
    <canvas data-shade data-src={wall.src} aria-hidden="true"></canvas>
    <div class="veil"></div>
    <div class="words">
      <h1 class="sr">{c.businessName} — {c.tagline}</h1>
      <div class="stack" data-kinetic aria-hidden="true"><span>One</span><span>room</span></div>
      <p class="sub">{c.tagline}. There is a single dormitory here, and that is deliberate.</p>
    </div>
  </section>

  <!-- Three platforms, three cells, never averaged. -->
  <section class="row row--3">
    {[hw, bk, gg].filter(Boolean).map((r, i) => (
      <div class={i === 1 ? 'cell cell--ochre' : 'cell'}>
        <p class="score">{r.score}<span> /{r.scale}</span></p>
        <p>{label(r.platform)} · {r.count} reviews</p>
      </div>
    ))}
  </section>

  <section class="row row--2">
    <div class="cell">
      <p class="eyebrow">Where it is</p>
      <h2>{intro.heading}</h2>
    </div>
    <div class="cell">{paras(intro.body).map((p, i) => <p class={i === 0 ? 'lead' : ''}>{p}</p>)}</div>
  </section>

  <!-- The black gate. The dossier's own note says guests cannot find this
       place; a map and four lines on a site fix it today. -->
  <section class="row row--2">
    <div class="cell cell--ochre">
      <p class="eyebrow" style="color:#5e5140">Finding the door</p>
      <h2>{finding.heading}</h2>
      <p style="margin-top:14px">Guests have got lost here. Now you will not.</p>
      <p style="margin-top:14px"><a class="link" style="color:var(--ink)" href={mapUrl} rel="noopener">Open the map</a></p>
    </div>
    <div class="cell cell--ochre" style="border-left-color:rgba(23,20,16,.28)">
      <ol class="steps" style="margin-top:0">{steps.map((s) => <li>{s}</li>)}</ol>
    </div>
  </section>

  <section class="run" role="group" aria-label="Photographs of the hostel">
    {run.map((id) => {
      const p = photo(id);
      return (
        <figure>
          <img src={p.src} srcset={p.srcset} sizes="(min-width: 900px) 26rem, 80vw"
               width={p.width} height={p.height} alt={p.alt} loading="lazy" decoding="async" />
          <figcaption>{p.alt}</figcaption>
        </figure>
      );
    })}
  </section>

  <section class="row row--2">
    <div class="cell">
      <p class="eyebrow">The room</p>
      <h2>{oneDorm.heading}</h2>
      {c.rooms.map((r) => (
        <div style="margin-top:22px">
          <p style="font-family:var(--disp);font-weight:700;font-size:1.25rem;letter-spacing:-.025em;margin:0">{r.label}</p>
          <p style="color:var(--muted);font-size:15px;margin:.2rem 0 0">{r.beds}</p>
          {r.note ? <p style="color:var(--muted);font-size:13.5px;margin:.3rem 0 0">{r.note}</p> : null}
          <p style="margin-top:14px"><a class="link" href="#book" data-open-drawer style="font-size:11.5px;letter-spacing:.14em;text-transform:uppercase">Check this bed</a></p>
        </div>
      ))}
    </div>
    <div class="cell">{paras(oneDorm.body).map((p, i) => <p class={i === 0 ? 'lead' : ''}>{p}</p>)}</div>
  </section>

  <section class="row row--2">
    <div class="cell cell--pale">
      <p class="eyebrow">What is in it</p>
      <h2>{offer.heading}</h2>
      {paras(offer.body).map((p) => <p>{p}</p>)}
    </div>
    <div class="cell cell--pale">
      <p class="eyebrow">Everything here</p>
      <ul class="amen">{c.amenities.map((a) => <li>{a.label}{a.note ? <span class="note"> — {a.note}</span> : null}</li>)}</ul>
    </div>
  </section>

  <section class="row row--2">
    <div class="cell">
      <p class="eyebrow">Newly built</p>
      <h2>{newlyBuilt.heading}</h2>
    </div>
    <div class="cell">{paras(newlyBuilt.body).map((p, i) => <p class={i === 0 ? 'lead' : ''}>{p}</p>)}</div>
  </section>

  <!-- The guests' own words, one to a frame. -->
  <section class="row row--2">
    {c.testimonials.slice(0, 2).map((t, i) => (
      <div class={i === 0 ? 'cell cell--ink' : 'cell cell--ink'}>
        {i === 0 ? <p class="eyebrow">What guests wrote</p> : null}
        <figure class="quote">
          <blockquote>“{t.quote}”</blockquote>
          <figcaption>{t.author} — {t.source === 'booking' ? 'Booking.com' : 'Hostelworld'}</figcaption>
        </figure>
      </div>
    ))}
  </section>
  <section class="row row--3">
    {c.testimonials.slice(2).map((t) => (
      <div class="cell">
        <figure class="quote">
          <blockquote>“{t.quote}”</blockquote>
          <figcaption>{t.author} — {t.source === 'booking' ? 'Booking.com' : 'Hostelworld'}</figcaption>
        </figure>
      </div>
    ))}
  </section>

  <section class="row row--2">
    <div class="cell">
      <p class="eyebrow">The wave</p>
      <h2 style="max-width:14ch">Kabalana, two minutes away</h2>
      <p class="lead">{c.spot}</p>
      <p class="eyebrow" style="margin-top:38px">Before you arrive</p>
      {paras(practical.body).map((p) => <p>{p}</p>)}
      <ul class="facts">
        <li><span class="k">Check in</span><span>{si.checkInFrom}–{si.checkInTo}</span></li>
        <li><span class="k">Check out</span><span>by {si.checkOutTo}</span></li>
        <li><span class="k">Address</span><span>{c.contact.address}</span></li>
        <li><span class="k">Good to know</span><span>{si.note}</span></li>
      </ul>
    </div>
    <div class="cell cell--pale">
      <p class="eyebrow">Today at Kabalana</p>
      <div class="widget">
        <iframe
          src="https://rosa.surf/widget/?spot=kabalana&theme=light&units=metric"
          title="Rosa surf forecast - Kabalana"
          width="100%" height="500"
          style="max-width:420px;border:0;border-radius:16px;display:block"
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          sandbox="allow-scripts allow-popups allow-popups-to-escape-sandbox allow-same-origin"
        ></iframe>
        <p>Live forecast — rosa.surf</p>
      </div>
    </div>
  </section>

  <footer class="foot" id="book">
    <div class="cols">
      <div>
        <h3>Where</h3>
        <p>{c.contact.address}</p>
        <p><a class="link" href={mapUrl} rel="noopener">Open in Google Maps</a></p>
      </div>
      <div>
        <h3>Reception</h3>
        <p><a class="link" href={`tel:${c.contact.phone}`}>{c.contact.phone}</a></p>
        <p>Limited hours — check in {si.checkInFrom}–{si.checkInTo}.</p>
      </div>
      <div>
        <h3>Book</h3>
        <ul>{c.bookingLinks.map((b) => <li><a class="link" href={b.url} rel="noopener">{b.label}</a></li>)}</ul>
      </div>
    </div>
    <p class="legal">Mockup 3 of 3 — “unique”. Every fact on this page comes from the dossier harvested on 19 September 2026; see notes.md. Photographs are the hostel's own; the shadow moving on the first one is drawn in WebGL and alters nothing in the photograph.</p>
  </footer>

</div>

<details class="drawer" data-drawer>
  <summary>Booking</summary>
  <div class="backdrop" data-close-drawer></div>
  <div class="panel">
    <button class="close" type="button" data-close-drawer>Close</button>
    <h2>Check dates</h2>
    <p>There is one dormitory, and these three listings hold its live prices. The property does not take credit cards on arrival, and reception keeps limited hours — check in {si.checkInFrom}–{si.checkInTo}.</p>
    <div class="acts">
      {c.bookingLinks.map((b, i) => {
        const Mark = marks[platform(b.label)];
        return <a class={i === 0 ? 'act act--rust' : 'act'} href={b.url} rel="noopener"><Mark light={i === 0} /> {b.label}</a>;
      })}
      <a class="act" href={`tel:${c.contact.phone}`}><PhoneMark /> Call {c.contact.phone}</a>
    </div>
  </div>
</details>

<nav class="mobile-dock" aria-label="Book">
  <a href="#book" data-open-drawer>Check dates</a>
  <a class="alt" href={`tel:${c.contact.phone}`}>Call</a>
</nav>

<script>
import { startShade } from '../scripts/shade.js';

const canvas = document.querySelector('[data-shade]');
const shade = canvas && startShade(canvas, canvas.dataset.src);
if (shade) canvas.classList.add('on');

const stack = document.querySelector('[data-kinetic]');
if (stack && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
  const lines = [...stack.children];
  addEventListener('pointermove', (e) => {
    const k = (e.clientX / innerWidth - 0.5) * 2;
    lines.forEach((l, i) => l.style.setProperty('--x', `${(k * (i - 0.5) * 3.4).toFixed(2)}vw`));
  }, { passive: true });
}

/* Triggers are real links to the footer booking block, so they work with
   JavaScript off; the script upgrades them into the slide-out. */
const drawer = document.querySelector('[data-drawer]');
let opener = null;
const open = (e) => { e.preventDefault(); opener = e.currentTarget; drawer.open = true; drawer.querySelector('.act')?.focus({ preventScroll: true }); };
const close = () => { drawer.open = false; opener?.focus({ preventScroll: true }); opener = null; };
document.querySelectorAll('[data-open-drawer]').forEach((b) => b.addEventListener('click', open));
document.querySelectorAll('[data-close-drawer]').forEach((b) => b.addEventListener('click', close));
addEventListener('keydown', (e) => { if (e.key === 'Escape' && drawer.open) close(); });
</script>

</body>
</html>
