{
  "name": "lotus-surf-house-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "seed": "bash scripts/make-media.sh",
    "fetch": "node scripts/fetch-tenant.mjs",
    "media": "node ../../../cms/publisher/src/video.mjs . && node scripts/photos.mjs",
    "build": "node scripts/photos.mjs && astro build",
    "build:cms": "node scripts/fetch-tenant.mjs && node ../../../cms/publisher/src/video.mjs . && node scripts/photos.mjs && astro build",
    "preview": "astro preview"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "astro": "7.3.3",
    "sharp": "0.35.4"
  }
}
