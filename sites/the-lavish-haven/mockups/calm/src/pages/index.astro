---
import '../styles/site.css';
import content from '../tenant/content.json';
import { blocks, paras, photo, type Content } from '../lib/content';
const c = content as unknown as Content;
const intro = blocks(c,'intro'), about = blocks(c,'about'), offer = blocks(c,'offer'), info = blocks(c,'info');
const hero = photo(c,0);
const title = `${c.businessName}${c.tagline ? ' — ' + c.tagline : ''}`;
const scale = (r:any) => r.scale === '5' ? '/5' : '/10';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={intro[0]?.body.split('\n')[0].slice(0,150)} />
</head>
<body>
  <header class="top">
    <div class="wrap bar">
      <span class="name">{c.businessName}</span>
      <nav class="sans eyebrow">
        <a href="#stay">Stay</a><a href="#rooms">Rooms</a><a href="#guests">Guests</a><a href="#find">Find us</a>
      </nav>
    </div>
  </header>

  <main>
    <div class="wrap hero">
      {c.tagline && <p class="eyebrow sans">{c.tagline}</p>}
      <h1>{intro[0]?.heading ?? c.businessName}</h1>
      {intro[0] && <p class="lede">{paras(intro[0])[0]}</p>}
    </div>
    {hero && <div class="wrap"><figure class="hero-figure"><img src={hero.src} alt={hero.alt} width="1600" height="900" fetchpriority="high" /></figure></div>}

    <section id="stay"><div class="wrap editorial">
      <div class="sticky">
        <h2>{about[0]?.heading}</h2>
        {c.ratings && c.ratings.length > 0 && (
          <ul class="scores sans">{c.ratings.map(r => <li><b>{r.score}{scale(r)}</b> · {r.platform} · {r.count} reviews</li>)}</ul>
        )}
      </div>
      <div>
        {about[0] && paras(about[0]).map(p => <p>{p}</p>)}
        {about[1] && <><h3>{about[1].heading}</h3>{paras(about[1]).map(p => <p>{p}</p>)}</>}
        <div class="figure-stack two reveal">
          {photo(c,1) && <img src={photo(c,1)!.src} alt={photo(c,1)!.alt} loading="lazy" width="800" height="1000" />}
          {photo(c,2) && <img src={photo(c,2)!.src} alt={photo(c,2)!.alt} loading="lazy" width="800" height="1000" />}
        </div>
      </div>
    </div></section>

    <section id="rooms"><div class="wrap">
      <h2>{offer[0]?.heading}</h2>
      <div class="editorial flip">
        <div>
          {offer[0] && paras(offer[0]).map(p => <p>{p}</p>)}
          {c.rooms && c.rooms.length > 0 && (
            <div class="rooms">{c.rooms.map(r => (
              <div class="room"><h3 class="sans" style="font-size:var(--step-0)">{r.label}</h3>
                <p class="beds" style="margin:0">{[r.beds, r.sleeps ? `sleeps ${r.sleeps}` : null, r.note].filter(Boolean).join(' · ')}</p>
              </div>))}</div>
          )}
        </div>
        <div class="figure-stack">
          {photo(c,3) && <img class="wide" src={photo(c,3)!.src} alt={photo(c,3)!.alt} loading="lazy" width="1200" height="800" />}
          {offer[1] && <div><h3>{offer[1].heading}</h3>{paras(offer[1]).map(p => <p>{p}</p>)}</div>}
        </div>
      </div>
    </div></section>

    {c.amenities && c.amenities.length > 0 && (
      <section><div class="wrap">
        <h2>What is here</h2>
        <ul class="amenities sans">{c.amenities.map(a => <li>{a.label}{a.note && <span> — {a.note}</span>}</li>)}</ul>
      </div></section>
    )}

    {c.testimonials && c.testimonials.length > 0 && (
      <section id="guests"><div class="wrap">
        <h2>What guests wrote</h2>
        <div class="quotes">{c.testimonials.map(t => (
          <blockquote class="reveal"><p>“{t.quote}”</p><cite>{t.author} · {t.source}{t.date ? ` · ${t.date}` : ''}</cite></blockquote>
        ))}</div>
      </div></section>
    )}

    <section id="find"><div class="wrap editorial">
      <div>
        <h2>{info[0]?.heading}</h2>
        {info[0] && paras(info[0]).map(p => <p>{p}</p>)}
        {info[1] && <><h3>{info[1].heading}</h3>{paras(info[1]).map(p => <p>{p}</p>)}</>}
      </div>
      <div>
        <dl class="facts sans">
          {c.contact.address && <div><dt>Address</dt><dd>{c.contact.address}</dd></div>}
          {c.contact.phone && <div><dt>Phone</dt><dd><a href={`tel:${c.contact.phone}`}>{c.contact.phone}</a></dd></div>}
          {c.stayInfo?.checkInFrom && <div><dt>Check in</dt><dd>{c.stayInfo.checkInFrom}–{c.stayInfo.checkInTo}</dd></div>}
          {c.stayInfo?.checkOutTo && <div><dt>Check out</dt><dd>until {c.stayInfo.checkOutTo}</dd></div>}
          {c.spot && <div><dt>The wave</dt><dd>{c.spot}</dd></div>}
        </dl>
        {c.stayInfo?.note && <p class="eyebrow sans" style="margin-top:1rem">{c.stayInfo.note}</p>}
      </div>
    </div></section>
  </main>

  <footer><div class="wrap">
    <p>{c.businessName}{c.contact.address ? ` · ${c.contact.address}` : ''}</p>
  </div></footer>

  <div class="book-bar sans">
    <span class="price-note">Rates change with the dates</span>
    <button class="btn solid" id="book">Check availability</button>
  </div>

  <dialog class="drawer" id="drawer">
    <div class="drawer-panel">
      <h2>Check availability</h2>
      <p class="eyebrow sans">Live rates and free dates are on the booking channels.</p>
      <ul class="channels sans">
        {(c.bookingLinks||[]).map(l => <li><a href={l.url} rel="noopener" target="_blank">{l.label}<span aria-hidden="true">→</span></a></li>)}
        {c.contact.whatsapp && <li><a href={`https://wa.me/${c.contact.whatsapp.replace(/\D/g,'')}`} rel="noopener" target="_blank">Message on WhatsApp<span aria-hidden="true">→</span></a></li>}
        {c.contact.phone && <li><a href={`tel:${c.contact.phone}`}>Call {c.contact.phone}<span aria-hidden="true">→</span></a></li>}
      </ul>
      <p style="margin-top:1.2rem"><button class="btn" id="close">Close</button></p>
    </div>
  </dialog>

  <script>
    const d = document.getElementById('drawer');
    document.getElementById('book')?.addEventListener('click', () => d?.showModal());
    document.getElementById('close')?.addEventListener('click', () => d?.close());
    d?.addEventListener('click', (e) => { if (e.target === d) d.close(); });
  </script>
</body>
</html>
