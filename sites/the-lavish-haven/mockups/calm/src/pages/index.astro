---
import { c, block, blocks, paras, photo, rating } from '../lib/content';
import '../styles/site.css';

const hero = photo('img-002');
const booking = rating('booking');
const google = rating('google');
const intro = block('intro');
const [newness, staff] = blocks('about');
const [roomsCopy, facilities] = blocks('offer');
const practical = block('info');
const plates = [
  { id: 'img-078', tall: false },
  { id: 'img-072', tall: true },
  { id: 'img-014', tall: false },
  { id: 'img-042', tall: false },
  { id: 'img-065', tall: false },
  { id: 'img-057', tall: true },
  { id: 'img-047', tall: false },
  { id: 'img-079', tall: false },
];
const primary = c.bookingLinks[0];
const secondary = c.bookingLinks[1];
const mapUrl = 'https://www.google.com/maps/search/The%20Lavish%20Haven%20Ahangama/@5.9794134,80.350836,17z?hl=en';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{c.businessName} — {c.tagline}</title>
<meta name="description" content={`${c.tagline}. ${paras(intro.body)[0]}`} />
<link rel="preload" href="fonts/instrumentserif.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>

<a class="btn" href="#book" style="position:absolute;left:-9999px">Skip to booking</a>

<header class="site-head wrap">
  <div>
    <div class="name">{c.businessName}</div>
    <div class="where">Ahangama · Sri Lanka</div>
  </div>
  <a class="btn head-book" href="#book">Check dates</a>
</header>

<section class="hero">
  <figure>
    <img src={hero.src} srcset={hero.srcset} sizes="100vw" width={hero.width} height={hero.height}
         alt={hero.alt} fetchpriority="high" />
    <div class="scrim"></div>
  </figure>
  <div class="words">
    <div class="wrap">
      <h1>{c.tagline}</h1>
      <p class="tagline">{c.businessName}, a two-minute walk from Kabalana Beach.</p>
      <p class="scores">
        {booking && <span><b>{booking.score}</b>/{booking.scale} on Booking.com · {booking.count} reviews</span>}
        {google && <span><b>{google.score}</b>/{google.scale} on Google · {google.count} reviews</span>}
      </p>
    </div>
  </div>
</section>

<!-- Docked availability strip. There is no booking engine of our own: the two
     links below are the channels the hotel already answers on, copied from the
     dossier. No dates are prefilled, because rates are live OTA inventory. -->
<section class="dock" id="book">
  <div class="wrap inner">
    <p class="note">Rates change with the dates and the room. These are the hotel's own listings — they show what is free tonight.</p>
    <div class="acts">
      <a class="btn btn--solid" href={primary.url} rel="noopener">{primary.label}</a>
      <a class="btn" href={secondary.url} rel="noopener">{secondary.label}</a>
      <a class="btn" href={`tel:${c.contact.phone}`}>Call the front desk</a>
    </div>
  </div>
</section>

<main>

<section class="sec wrap">
  <p class="eyebrow">Where it is</p>
  <div class="two-col">
    <h2>{intro.heading}</h2>
    <div>
      {paras(intro.body).map((p, i) => <p class={i === 0 ? 'lead' : ''}>{p}</p>)}
    </div>
  </div>

  <div class="plates">
    {plates.map(({ id, tall }) => {
      const p = photo(id);
      return (
        <figure class={tall ? 'plate plate--tall' : 'plate'}>
          <img src={p.src} srcset={p.srcset} sizes="(min-width: 860px) 24vw, 46vw"
               width={p.width} height={p.height} alt={p.alt} loading="lazy" decoding="async" />
          <figcaption>{p.alt}</figcaption>
        </figure>
      );
    })}
  </div>
</section>

<section class="sec wrap">
  <p class="eyebrow">The rooms</p>
  <div class="two-col">
    <h2>{roomsCopy.heading}</h2>
    <div>{paras(roomsCopy.body).map((p) => <p>{p}</p>)}</div>
  </div>
  <ul class="rooms">
    {c.rooms.map((r) => (
      <li>
        <span class="label">{r.label}</span>
        <span class="beds">{r.beds}{r.note ? `, ${r.note}` : ''}</span>
        <span class="sleeps">{r.sleeps ? `Sleeps ${r.sleeps}` : ''}</span>
      </li>
    ))}
  </ul>
</section>

<section class="sec wrap">
  <p class="eyebrow">What is here</p>
  <div class="two-col">
    <h2>{facilities.heading}</h2>
    <div>{paras(facilities.body).map((p) => <p>{p}</p>)}</div>
  </div>
  <ul class="amen" style="margin-top:30px">
    {c.amenities.map((a) => (
      <li>{a.label}{a.note ? <span class="note"> — {a.note}</span> : null}</li>
    ))}
  </ul>
</section>

<section class="sec wrap">
  <p class="eyebrow">Recently opened</p>
  <div class="two-col">
    <h2>{newness.heading}</h2>
    <div>{paras(newness.body).map((p, i) => <p class={i === 0 ? 'lead' : ''}>{p}</p>)}</div>
  </div>
</section>

<section class="sec wrap">
  <p class="eyebrow">What guests wrote</p>
  <h2 style="max-width:18ch">{staff.heading}</h2>
  <div style="max-width:34rem;margin-bottom:34px">{paras(staff.body).map((p) => <p>{p}</p>)}</div>
  <div class="quotes">
    {c.testimonials.map((t) => (
      <figure class="quote">
        <blockquote>“{t.quote}”</blockquote>
        <figcaption>{t.author} — on {t.source === 'booking' ? 'Booking.com' : t.source}</figcaption>
      </figure>
    ))}
  </div>
</section>

<section class="sec wrap">
  <p class="eyebrow">The wave</p>
  <p class="lead">{c.spot}</p>
</section>

<section class="sec wrap">
  <p class="eyebrow">Before you arrive</p>
  <div class="two-col">
    <h2>{practical.heading}</h2>
    <div>{paras(practical.body).map((p) => <p>{p}</p>)}</div>
  </div>
</section>

</main>

<footer class="foot">
  <div class="wrap">
    <div class="cols">
      <div>
        <h3>Where</h3>
        <p>{c.contact.address}</p>
        <p><a class="link" href={mapUrl} rel="noopener">Open in Google Maps</a></p>
      </div>
      <div>
        <h3>Front desk</h3>
        <p><a class="link" href={`tel:${c.contact.phone}`}>{c.contact.phone}</a></p>
        <p>{c.stayInfo.note}</p>
      </div>
      <div>
        <h3>Book</h3>
        <ul>{c.bookingLinks.map((b) => <li><a class="link" href={b.url} rel="noopener">{b.label}</a></li>)}</ul>
      </div>
    </div>
    <p class="legal">Mockup 1 of 3 — “calm”. Every fact on this page comes from the dossier harvested on 19 September 2026; see notes.md. Photographs are the hotel's own listing photographs.</p>
  </div>
</footer>

<nav class="mobile-dock" aria-label="Book">
  <a href={primary.url} rel="noopener">Check dates</a>
  <a class="alt" href={`tel:${c.contact.phone}`}>Call</a>
</nav>

</body>
</html>
