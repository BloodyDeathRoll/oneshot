{% extends 'partials/base.html.twig' %}
{% set hero = page.media[page.header.hero_image] ?: page.media.images|first %}
{% set prices = pages.find('/lessons').header.prices %}
{% block content %}
  <section class="hero">
    <div class="hero-media">
      {% if hero %}<img src="{{ hero.cropZoom(1600, 1000).url }}" alt="{{ page.header.hero_alt|e }}" width="1600" height="1000">{% endif %}
      <canvas data-waves aria-hidden="true"></canvas>
    </div>
    <div class="hero-text">
      <p class="kicker">{{ page.header.kicker|e }}</p>
      <h1>{{ page.header.headline|e }} <em>{{ page.header.headline_accent|e }}</em></h1>
      <p class="tagline">{{ page.header.tagline|e }}</p>
    </div>
  </section>
  <section class="split">
    <aside class="teaser">
      Lessons from
      <span class="from">{{ (prices|first).price|e }}</span>
      <a class="btn" href="{{ pages.find('/lessons').url }}">See lessons &amp; prices</a>
    </aside>
    <div class="prose">{{ page.content|raw }}</div>
  </section>
{% endblock %}
{% block scripts %}<script src="{{ url('theme://js/waves.js') }}" defer></script>{% endblock %}
