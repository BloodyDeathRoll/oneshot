# Copy to .env and fill in, or (recommended) run ./scripts/init-env.sh which generates every
# secret below. .env is git-ignored. Never commit real values.

# --- CMS -------------------------------------------------------------------------------
CMS_PORT=3100                      # published on 127.0.0.1 only
SERVER_URL=http://localhost:3100   # public URL of the CMS (https://… in production)
COOKIE_SECURE=false                # true behind HTTPS
POSTGRES_PASSWORD=                 # generated
PAYLOAD_SECRET=                    # generated; also encrypts API keys — changing it invalidates them
SUPERADMIN_EMAIL=admin@oneshot.invalid
SUPERADMIN_PASSWORD=               # generated; first boot creates this super-admin
BUILDER_API_KEY=                   # generated; read-only key the Astro build uses

# --- Publisher -------------------------------------------------------------------------
PUBLISH_SECRET=                    # generated; shared secret between the CMS hook and the publisher
PUBLISHER_PORT=4100                # host-mode only (the compose service is not published)
DEPLOY_MODE=dry-run                # dry-run | live   (live really runs `wrangler deploy`)
WORKER_PREFIX=oneshot-spike        # Worker name = <prefix>-<tenant-slug>
COMPATIBILITY_DATE=2026-09-17
DEBOUNCE_MS=1500                   # quiet period after a save before the build starts

# Only needed for DEPLOY_MODE=live inside compose. On the host, wrangler's own OAuth login is used.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
