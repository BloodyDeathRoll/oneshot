# Self-hosted (single-tenant) stack. Generate with: ./scripts/init-env.sh self-hosted
# .env.self-hosted is git-ignored. Never commit real values.

ONESHOT_PROFILE=single-tenant
SITE_SLUG=site                      # name of the one site (build dir / logs only)

# --- front door (Caddy) ------------------------------------------------------------------
SITE_ADDRESS=:80                    # real domain: example.com  → automatic HTTPS
HTTP_BIND=127.0.0.1:8180            # real domain: 0.0.0.0:80
HTTPS_BIND=127.0.0.1:8543           # real domain: 0.0.0.0:443
SERVER_URL=http://localhost:8180    # real domain: https://example.com
COOKIE_SECURE=false                 # real domain: true

# --- CMS ---------------------------------------------------------------------------------
POSTGRES_PASSWORD=                  # generated
PAYLOAD_SECRET=                     # generated
OWNER_EMAIL=owner@site.invalid      # THE one admin user, created at first boot
OWNER_PASSWORD=                     # generated — hand over sealed, owner changes it under /admin/account
BUILDER_API_KEY=                    # generated; read-only key for the site build

# --- publisher ---------------------------------------------------------------------------
PUBLISH_SECRET=                     # generated
DEBOUNCE_MS=1500
