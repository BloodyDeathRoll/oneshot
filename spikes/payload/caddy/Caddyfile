# Self-hosted (single-tenant) front door: the built static site + the CMS admin on one origin.
#
#   SITE_ADDRESS=:80            local testing — plain HTTP (compose publishes it on 127.0.0.1:8180)
#   SITE_ADDRESS=example.com    real domain — Caddy obtains and renews a Let's Encrypt certificate
#                               automatically; publish 80 + 443 (HTTP_BIND / HTTPS_BIND) and set
#                               SERVER_URL=https://example.com, COOKIE_SECURE=true
{
	admin off
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Payload: admin UI, REST API (login, uploads, media files) and Next.js assets
	@cms path /admin /admin/* /api/* /_next/*
	handle @cms {
		reverse_proxy cms:3000
	}

	# everything else: the static site. `current` is a symlink the publisher flips atomically.
	handle {
		root * /srv/www/current
		@hashed path /_astro/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle_errors {
		root * /srv/www/current
		rewrite * /404.html
		file_server
	}
}
